#!/usr/bin/env bash
# Lint everything that can be linted on this machine.
# Python, YAML, and shell run anywhere; ROS package linters need the ROS env.

# shellcheck source=scripts/_lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"

FAILED=0
check() { "$@" || FAILED=1; }

VENV="$(cite_venv_bin || echo "${REPO_ROOT}/.venv/bin")"

step "Python (ruff)"
if [ -x "${VENV}/ruff" ]; then
    # Both trees, not just tools/. The scenario suite is Python that runs in CI
    # and gates every phase item, and it went unlinted for as long as this line
    # named one directory — three violations sat in tests/scenarios/bringup.py
    # without anything reporting them. Each tree resolves its own ruff
    # configuration by discovery: tools/pyproject.toml declares the rules, and
    # tests/ruff.toml extends it rather than restating it.
    # A loop rather than `mapfile`: this step runs on the host, where macOS still
    # ships bash 3.2 and `mapfile` does not exist. The one in ros_lint() below is
    # safe because that block only runs where ROS does.
    PY_TREES=()
    while IFS= read -r tree; do
        [ -n "$tree" ] && PY_TREES+=("$tree")
    done < <(python_trees)
    check "${VENV}/ruff" check "${PY_TREES[@]}"
    check "${VENV}/ruff" format --check "${PY_TREES[@]}"
else
    warn "ruff not installed — run ./scripts/bootstrap --host-only"
fi

step "Types (mypy)"
if [ -x "${VENV}/mypy" ] && [ -d "${REPO_ROOT}/tools/cite_tools" ]; then
    check "${VENV}/mypy" "${REPO_ROOT}/tools/cite_tools"
else
    warn "mypy not installed or nothing to check"
fi

step "English only (P10)"
# Deliberately in the host half, which is the half that always runs. P10 binds every file
# in the repository, not only the ones a ROS environment can lint, and a rule enforced only
# on the Linux workstation is a rule half the contributors never meet. ADR-0035 records the
# instrument and what each rejected candidate was measured to fire on.
if [ -x "${VENV}/python" ]; then
    # Guarded like the documentation-link check below, and for the same reason: this is
    # cite_tools judging this checkout, not a third-party linter read out of ${VENV}/ by
    # path. A foreign copy would answer about a tree nobody is looking at.
    require_local_cite_tools "${VENV}/python" "The English-only check"
    check "${VENV}/python" -m cite_tools.english "${REPO_ROOT}"
else
    warn "cite_tools not installed — run ./scripts/bootstrap --host-only"
fi

step "Documentation links"
if [ -x "${VENV}/python" ]; then
    # The only step here that executes cite_tools rather than a third-party
    # linter, so it is the only one that can be another checkout's code judging
    # this checkout's documents. ruff, mypy and yamllint are read out of
    # ${VENV}/ by path and configured from this tree.
    require_local_cite_tools "${VENV}/python" "The documentation-link check"
    check "${VENV}/python" -m cite_tools.doclinks "${REPO_ROOT}"
else
    warn "cite_tools not installed — run ./scripts/bootstrap --host-only"
fi

# Derived assets (ADR-0028). The check form of ./scripts/hulls: every committed hull
# re-derived from the vendor file it names and compared byte for byte, plus the
# machine-written region of assets/manifest.yaml compared against what the same inputs
# produce.
#
# In the host half deliberately, and skipped rather than failed where the vendor source is
# absent. manifest.py argues that "a generated region that a check can falsify is stronger
# discipline than a hand-written one that nothing verifies", and until this step existed
# that argument rested on a command no script, no CI step and no test ever invoked. A hull
# that has gone stale against a vendor bump is a collision shape that does not match the
# arm, which ADR-0028 names as a failure that looks like a planner bug.
#
# The skip is a real weakness and is stated rather than hidden: on a laptop that has never
# run ./scripts/bootstrap this proves nothing. It must never be made fatal on the host —
# the whole point of the L0 layer being ROS-free is that these gates run from a machine
# that could never build the simulator.
#
# Where it gates in CI, exactly. The `host-tooling` job bootstraps with --host-only, which
# runs no `vcs import`, so this step SKIPS there. The `ros-workspace` job bootstraps with
# --in-container and then runs this script inside the image, so this step RUNS there. One
# of the two CI lint runs answers the question — do not read a green host-tooling job as
# having compared a hull against anything.
step "Derived assets (ADR-0028)"
if [ ! -d "${REPO_ROOT}/workspace/src/external/xarm_ros2" ]; then
    warn "SKIPPED — the vendor source is not imported in this checkout."
    warn "  A hull is a function of the vendor bytes, so there is nothing to compare against."
    warn "  For the full gate, in one command: ./scripts/enter dev ./scripts/lint"
else
    check "${REPO_ROOT}/scripts/hulls"
fi

step "YAML"
if [ -x "${VENV}/yamllint" ]; then
    # .yamllint's own ignore list scopes this; passing the repo root means a new
    # YAML file is linted the day it appears rather than whenever someone
    # remembers to add its directory here.
    check "${VENV}/yamllint" -s "${REPO_ROOT}"
else
    warn "yamllint not installed"
fi

step "Shell"
# The pinned binary out of ${VENV}/ by path, never taken off PATH. WHICH linter
# answers decides what this step means, and PATH answered differently on all
# three machines this gate runs on — see the block on it in scripts/_lib.sh and
# the pin in requirements/dev.txt.
#
# A refusal rather than a warning, and unlike the steps above it. Those still warn
# on a missing tool because a missing ruff is an unbootstrapped laptop. A missing
# linter here used to be that too, and was ALSO the container's steady state,
# where "skipped" meant this gate reported success having read no shell script at
# all. The pin removes the ambiguity, so the skip may go with it.
if SHELL_GATE="$(assert_shellcheck_pinned "${VENV}/shellcheck" "$CITE_DEV_REQUIREMENTS")"; then
    # -x follows sourced files, so the `source=` directives in each script resolve
    check "${VENV}/shellcheck" -x -P "${REPO_ROOT}" \
        "${REPO_ROOT}"/scripts/* "${REPO_ROOT}"/infra/docker/*.sh
else
    FAILED=1
    err "Shell gate broken — ${SHELL_GATE}.
  A gate that cannot say WHICH shellcheck answered is not a gate: the same
  scripts are clean under one version and dirty under another, and that is
  the defect this pin exists to remove.
  Run ./scripts/bootstrap --host-only to install the pinned version."
fi

# -----------------------------------------------------------------------------
# ROS package linters.
#
# A gate that cannot tell "clean" from "did not run" is worse than no gate: it
# reports success while checking nothing, and every report built on it overstates
# what was verified. This block used to do exactly that, in two compounding ways:
#
#   1. `--packages-skip-build-finished` skipped every already-built package — in
#      practice all of them — so colcon printed "Summary: 0 packages finished"
#      and this script printed "Lint clean". The flag is gone.
#   2. Even with every package selected, ctest reports "No tests were found!!!"
#      and exits 0, because the packages declare `ament_lint_auto` but no linter
#      set for `ament_lint_auto_find_test_dependencies()` to discover. colcon does
#      not treat an empty test set as an error, so this is asserted explicitly.
#
# Both conditions now fail the gate and name what is missing, rather than passing.
# -----------------------------------------------------------------------------
ros_lint() {
    local -a packages=()
    mapfile -t packages < <(first_party_packages)

    local build="${REPO_ROOT}/workspace/build"
    if [ ! -d "$build" ]; then
        die "Lint gate broken: workspace/build does not exist, so no linter can run.
  Run ./scripts/build first."
    fi

    # Before asking ctest anything. This gate's whole output is a claim about
    # which linters a package registers, and that is decided at CMake configure
    # time — so against a stale tree it reports the linter set of an older
    # package.xml with complete confidence. That exact false negative is what
    # made two correctly-configured packages look broken here.
    assert_build_inputs_current "The lint gate"

    # Scoped to our own packages: linting vcstool-imported vendor source reports
    # their style choices, which we neither control nor should change.
    #
    # Selected by LABEL (-L linter), not by name (-R lint). ament registers every
    # linter with the `linter` label, and the names are only sometimes spelled
    # with "lint" in them. `-R lint` matched cpplint, lint_cmake and xmllint and
    # silently dropped flake8, pep257, copyright, cppcheck and uncrustify — so
    # this gate ran three of eight linters per package while reporting "Lint
    # clean", and five of them had never executed under it at all. An agent's
    # change passed here with flake8 and pep257 genuinely failing.
    #
    # Verified rather than reasoned about: `ctest -N -L linter` on cite_skills
    # lists 8 tests, `ctest -N -R lint` lists 3.
    local log rc=0
    log="$(mktemp)"
    if [ "${#packages[@]}" -gt 0 ]; then
        (cd "${REPO_ROOT}/workspace" && colcon test \
            --packages-select "${packages[@]}" \
            --event-handlers console_direct+ \
            --return-code-on-test-failure \
            --ctest-args -L linter) >"$log" 2>&1 || rc=$?
        cat "$log"
    fi

    # A real linter failure is reported as such and outranks everything below —
    # the coverage questions only make sense about a run that itself succeeded.
    if [ "$rc" -ne 0 ]; then
        rm -f "$log"
        FAILED=1
        return 0
    fi

    local finished
    finished="$(sed -n 's/^Summary: \([0-9][0-9]*\) package.*/\1/p' "$log" | tail -1)"
    finished="${finished:-0}"
    rm -f "$log"

    # Which packages registered no linter at all? Asked of ctest directly rather
    # than inferred from colcon's prose, so the answer is per package and exact.
    #
    # Same label selector as the run above, and it has to stay the same: when this
    # counted `-R lint` while the run used `-R lint` too, the coverage check was
    # counting the wrong population — a package registering only flake8 and pep257
    # would have been reported as registering no linter at all.
    local pkg n
    local -a without_linters=()
    for pkg in "${packages[@]}"; do
        if [ ! -f "${build}/${pkg}/CTestTestfile.cmake" ]; then
            without_linters+=("${pkg}(not-built)")
            continue
        fi
        n="$(ctest --test-dir "${build}/${pkg}" -N -L linter 2>/dev/null \
             | sed -n 's/^Total Tests: //p' | tail -1 || true)"
        [ "${n:-0}" -gt 0 ] || without_linters+=("$pkg")
    done

    local diagnosis
    if ! diagnosis="$(assert_lint_coverage \
            "${#packages[@]}" "$finished" ${without_linters[@]+"${without_linters[@]}"})"; then
        die "Lint gate broken — ${diagnosis}.
  A gate that cannot tell 'clean' from 'never ran' must not report success.
  Every first-party package needs a linter set for ament_lint_auto to discover:
    package.xml:    <test_depend>ament_lint_common</test_depend>
    CMakeLists.txt: find_package(ament_lint_auto REQUIRED)
                    ament_lint_auto_find_test_dependencies()
  Declaring only <test_depend>ament_lint_auto</test_depend> registers zero linters."
    fi
}

RAN_ROS_LINT=0
if in_container || native_ros_available; then
    step "ROS packages"
    ros_lint
    RAN_ROS_LINT=1
else
    # Never skip this silently. A green ./scripts/lint on a laptop used to be
    # indistinguishable from a green one in the container, and only the second
    # has looked at a single line of C++.
    step "ROS packages"
    warn "SKIPPED — no ROS 2 environment on this host."
    warn "  The Python, YAML, shell and documentation checks above did run."
    warn "  The C++, CMake and package linters did NOT."
    warn "  For the full gate, in one command: ./scripts/enter dev ./scripts/lint"
fi

if [ "$FAILED" -ne 0 ]; then
    die "Lint failed"
fi
if [ "$RAN_ROS_LINT" -eq 1 ]; then
    ok "Lint clean"
else
    ok "Lint clean — host checks only; ROS package linters were not run"
fi
