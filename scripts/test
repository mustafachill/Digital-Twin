#!/usr/bin/env bash
# Run the test suites: host tooling tests, then ROS workspace tests.
#
#   ./scripts/test
#   ./scripts/test --host-only              host tooling tests only, never Docker
#   ./scripts/test --packages-select cite_facility

# shellcheck source=scripts/_lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"

# The ROS-free suites, run wherever this script happens to be.
#
# Once per invocation, not once per environment. On a machine without ROS this
# script ran them, re-executed itself inside the container, and the inner run
# reached them again — the log showed "94 passed in 1.52s" and then "94 passed in
# 1.97s", and the total a reader takes away from that is twice the truth. The
# CITE_*_DONE flags are carried across the boundary by exec_in_container, and are
# set only once a suite has actually run, so a host with no virtualenv still gets
# the Python suite in the container instead of it being skipped in both places.
#
# PYTHONPATH is cleared deliberately. Inside the container the ROS setup puts
# /opt/ros/jazzy/lib/python3.12/site-packages on PYTHONPATH, and pytest autoloads
# a plugin from every distribution it can see there — including launch_testing,
# which then fails to import `lark` because that lives in the system interpreter's
# dist-packages and not in the tooling virtualenv. The host suite is ROS-free by
# design (ADR-0013); letting it see the ROS Python path at all is the bug, and the
# symptom is a traceback deep inside launch_testing that has nothing to do with
# the tests being run.

# Regression tests for the gate logic itself. No interpreter, no ROS and no
# virtualenv, so this is never the suite that quietly gets skipped.
run_shell_selftests() {
    if [ "${CITE_SELFTESTS_DONE:-0}" = "1" ]; then
        return 0
    fi
    step "Shell gate self-tests"
    bash "${REPO_ROOT}/scripts/_selftest.sh"
    export CITE_SELFTESTS_DONE=1
}

run_host_tests() {
    if [ "${CITE_HOST_TESTS_DONE:-0}" = "1" ]; then
        info "Host tooling tests already ran on the host — not repeating them here."
        return 0
    fi

    local py
    py="$(cite_python)" || true
    [ -n "$py" ] && [ -d "${REPO_ROOT}/tools/tests" ] || return 0

    # tools/tests is not a package and there is no conftest above it, so pytest
    # prepends tools/tests to sys.path and NOT tools/ — `import cite_tools` in
    # the suite therefore resolves through site-packages exactly as this check
    # asks. Verified rather than assumed: in a worktree with no virtualenv the
    # suite imported /Users/.../Digital-Twin/tools/cite_tools while the tests
    # themselves came from the worktree, so the result graded another checkout's
    # code. See require_local_cite_tools in scripts/_lib.sh.
    require_local_cite_tools "$py" "The host tooling test suite"

    # tests/ as well as tools/, because the scenario guards live there and were
    # collected by nothing. `tests/scenarios/guards/` checks that every scenario
    # module loads the way `launch_test` actually loads it — by path, never
    # registered in sys.modules — which is a defect class that reaches the branch
    # precisely when verification does not match how the code is loaded. A guard
    # no suite collects is not a guard.
    #
    # Read with a loop rather than `mapfile`, which is bash 4+. This suite runs
    # on the host BEFORE any re-execution into the container, and macOS still
    # ships bash 3.2 — the other `mapfile` call in this file is safe only because
    # it sits after that boundary. ADR-0013 is the whole point: the same command
    # has to work from the laptop.
    local paths=()
    local tree
    while IFS= read -r tree; do
        [ -n "$tree" ] && paths+=("$tree")
    done < <(python_trees)
    [ "${#paths[@]}" -gt 0 ] || return 0

    step "Host tooling tests"
    PYTHONPATH="" "$py" -m pytest "${paths[@]}" -q
    export CITE_HOST_TESTS_DONE=1
}

run_ros_free_suites() {
    run_shell_selftests
    run_host_tests
}

# --host-only runs the ROS-free suite and stops. CI's fast job uses it: without
# it, `./scripts/test` on a runner with Docker but no ROS would build the whole
# container image and duplicate the job that already does exactly that.
HOST_ONLY=0
ARGS=()
for arg in "$@"; do
    case "$arg" in
        --host-only) HOST_ONLY=1 ;;
        *)           ARGS+=("$arg") ;;
    esac
done
set -- ${ARGS[@]+"${ARGS[@]}"}

if [ "$HOST_ONLY" -eq 1 ]; then
    run_ros_free_suites
    ok "ROS-free suites complete (--host-only)"
    exit 0
fi

if ! in_container && ! native_ros_available; then
    run_ros_free_suites
    require_ros_env test "$@"
fi

run_ros_free_suites

step "ROS workspace tests"
cd "${REPO_ROOT}/workspace" || die "workspace/ not found"

if [ ! -d src ] || [ -z "$(ls -A src 2>/dev/null)" ]; then
    warn "workspace/src is empty — no ROS tests yet. See CLAUDE.md §2."
    exit 0
fi

mapfile -t OUR_PACKAGES < <(first_party_packages)
if [ "${#OUR_PACKAGES[@]}" -eq 0 ]; then
    warn "No first-party packages in workspace/src yet — only external source is present."
    exit 0
fi

# A test result read out of a stale tree describes code nobody is looking at. Two
# suites on this branch were believed red at base for hours on exactly that
# evidence, and passed on a fresh build.
assert_build_inputs_current "The test gate"

info "Testing ${#OUR_PACKAGES[@]} first-party package(s): ${OUR_PACKAGES[*]}"
colcon test \
    --packages-select "${OUR_PACKAGES[@]}" \
    --event-handlers console_direct+ \
    --return-code-on-test-failure "$@"
# test-result aggregates every result file under build/, including any left by a
# previous unscoped run over vendor packages. Scoping it to our own packages keeps
# the summary about our code — the exit status above is what actually gates.
for package in "${OUR_PACKAGES[@]}"; do
    if [ -d "build/${package}" ]; then
        colcon test-result --verbose --test-result-base "build/${package}" || true
    fi
done

ok "Tests complete"
