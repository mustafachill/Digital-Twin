#!/usr/bin/env bash
# Run the cell's fixed program on both sides of the twin pair, with the windows open.
#
#   ./scripts/program                  one cycle, both sides, one window each
#   ./scripts/program --headless       the same with no windows
#   ./scripts/program --cycles 3       three cycles (0 runs until Ctrl-C)
#   ./scripts/program --zone cell_b    name the zone rather than letting the model choose
#
# WHAT IT DOES. It brings up both sides of the paired cell WITHOUT the line, puts
# one work-piece on each side's pick table, and runs `python3 -m
# cite_bringup.program --via twin`: ONE program, through the twin boundary, moving
# both arms pose by pose and running both belts (ADR-0066). Then it reports where
# each box ended and tears the pair down. Ctrl-C stops the program (goal
# cancelled, belt commanded to zero) and then the pair.
#
# WHAT IT IS NOT. A demonstration, like ./scripts/demo: it gates nothing and is in
# no CI step. `./scripts/scenario program_cycle` is what CHECKS the program, on one
# side. ./scripts/demo still runs the parked event-driven line, unchanged.
#
# Read ./scripts/demo's header for the GPU and the speed of a windowed pair; all
# of it applies here.
#
# shellcheck source=scripts/_lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"

HEADLESS=0
ZONE=""
CYCLES=1
WANT=""
for arg in "$@"; do
    if [ -n "$WANT" ]; then
        case "$arg" in ""|-*|*:=*) die "${WANT} needs a value and was given '${arg}'." ;; esac
        if [ "$WANT" = "--zone" ]; then ZONE="$arg"; else CYCLES="$arg"; fi
        WANT=""; continue
    fi
    case "$arg" in
        --headless) HEADLESS=1 ;;
        --zone|--cycles) WANT="$arg" ;;
        -h|--help)  sed -n '2,20p' "$0"; exit 0 ;;
        *)          die "unknown argument '${arg}'. Try --help." ;;
    esac
done
[ -z "$WANT" ] || die "${WANT} needs a value."
case "$CYCLES" in ''|*[!0-9]*) die "--cycles needs a whole number, 0 for forever." ;; esac

# ---------------------------------------------------------------- on the host
if ! in_container; then
    # Refused on a dirty host for the reasons ./scripts/demo gives: a cell left up
    # answers on the same domain, and `compose exec` into a running container does
    # not run the image's entrypoint.
    if [ "$(docker ps -q 2>/dev/null | wc -l)" -ne 0 ]; then
        die "a container is already running, and this would attach to it rather than
  start a clean one. Stop it first:  docker ps   then   docker rm -f <id>"
    fi
    if [ ! -d "${REPO_ROOT}/.venv" ]; then
        step "No environment yet — preparing one. This happens once."
        "${REPO_ROOT}/scripts/bootstrap"
    fi
    if [ "$HEADLESS" -eq 0 ]; then
        [ "$(host_os)" != "macos" ] || die "the windows need an X display. Use --headless."
        [ -n "${DISPLAY:-}" ] || die "DISPLAY is not set. Use --headless."
        export CITE_SERVICE=gui
    fi
fi

require_ros_env program "$@"

# ----------------------------------------------------------- in the container
if [ ! -d "${REPO_ROOT}/workspace/install" ]; then
    step "Nothing is built yet — building. This happens once, and takes a while."
    "${REPO_ROOT}/scripts/build"
fi
source_overlay

if [ -z "$ZONE" ]; then
    # The paired zone, as the model declares it; see ./scripts/demo.
    ZONE="$(python3 -m cite_bringup.demo --print-zone)" \
        || die "could not work out which zone is paired. Name one with --zone."
fi

PAIR_LOG="$(mktemp -t cite-program-pair.XXXXXX.log)"
PAIR_PID=""
TAIL_PID=""
PROGRAM_PID=""

# Invoked by the trap below and never by name, which shellcheck cannot see.
# shellcheck disable=SC2329
teardown() {
    trap - EXIT
    trap 'warn "still stopping — the supervisor is working through its own ceilings"' INT TERM
    if [ -n "$TAIL_PID" ]; then kill "$TAIL_PID" 2>/dev/null || true; fi
    if [ -n "$PROGRAM_PID" ] && kill -0 "$PROGRAM_PID" 2>/dev/null; then
        # SIGINT, so the program cancels its goal and stops the belt itself.
        kill -INT "$PROGRAM_PID" 2>/dev/null || true
        wait "$PROGRAM_PID" 2>/dev/null || true
    fi
    if [ -n "$PAIR_PID" ] && kill -0 "$PAIR_PID" 2>/dev/null; then
        step "Stopping the pair"
        kill -INT "$PAIR_PID" 2>/dev/null || true
        wait "$PAIR_PID" 2>/dev/null || true
    fi
    ok "the cell is down. Its log was ${PAIR_LOG}, inside the container."
}
trap teardown INT TERM HUP EXIT

step "Bringing up both sides of ${ZONE}, without the line"
SIM_ARGS=(--zone "$ZONE" --pair)
[ "$HEADLESS" -eq 0 ] || SIM_ARGS+=(--headless)
"${REPO_ROOT}/scripts/sim" "${SIM_ARGS[@]}" > "$PAIR_LOG" 2>&1 &
PAIR_PID=$!
tail -n +1 -f "$PAIR_LOG" & TAIL_PID=$!

# An event, not a duration (P4): the loop only polls for the supervisor's token.
info "Waiting for both sides and the twin boundary to announce readiness"
READY=0
for _ in $(seq 1 180); do
    if grep -q 'CITE_BOUNDARY_READY' "$PAIR_LOG" 2>/dev/null; then READY=1; break; fi
    if ! kill -0 "$PAIR_PID" 2>/dev/null; then break; fi
    sleep 2
done
[ "$READY" -eq 1 ] || die "the pair never announced that it was ready. Its log is ${PAIR_LOG}"
kill "$TAIL_PID" 2>/dev/null || true
TAIL_PID=""
ok "both sides are up"

step "Putting a work-piece on each side's pick table"
# `cite_bringup.demo`'s own spawn, unchanged, so the box is the same box the
# parked line's demonstration uses.
python3 - "$ZONE" <<'PY' || die "a side would not take the box"
import sys
from pathlib import Path
from tempfile import NamedTemporaryFile
from cite_bringup.demo import SPAWN_DROP_M, frame, spawn
from cite_bringup.gz import plan_for
from cite_bringup.workpiece import SIDE_M, workpiece_sdf

zone = sys.argv[1]
plan = plan_for(zone)
pick = frame(plan, f"{zone}__infeed_table__surface")
at = (pick[0], pick[1], pick[2] + SIDE_M / 2.0 + SPAWN_DROP_M)
with NamedTemporaryFile("w", suffix=".sdf", delete=False) as sdf:
    sdf.write(workpiece_sdf("workpiece"))
try:
    for side in plan.sides:
        problem = spawn(zone, side.name, "workpiece", at, Path(sdf.name), timeout_s=180.0)
        if problem is not None:
            sys.exit(f"{side.name}: {problem}")
        print(f"  ok  {side.name}: box on the pick table")
finally:
    Path(sdf.name).unlink(missing_ok=True)
PY

step "Running the fixed program through the twin boundary"
python3 -u -m cite_bringup.program --zone "$ZONE" --via twin --cycles "$CYCLES" &
PROGRAM_PID=$!
STATUS=0
while kill -0 "$PROGRAM_PID" 2>/dev/null; do
    if ! kill -0 "$PAIR_PID" 2>/dev/null; then
        err "the pair ended while the program was running. Its log is ${PAIR_LOG}."
        STATUS=1
        break
    fi
    sleep 2
done
WAIT_RC=0
wait "$PROGRAM_PID" 2>/dev/null || WAIT_RC=$?
PROGRAM_PID=""
[ "$STATUS" -ne 0 ] || STATUS="$WAIT_RC"

step "Where each box ended"
# Read once, after the belt has stopped. Not a measurement of divergence: see
# ADR-0065 for that.
python3 - "$ZONE" <<'PY' || true
import sys
from cite_bringup.demo import frame, world_name
from cite_bringup.gz import ModelPoses, plan_for

zone = sys.argv[1]
plan = plan_for(zone)
outfeed = frame(plan, f"{zone}__{plan.conveyors[0].asset}__outfeed")
print(f"    outfeed frame at x={outfeed[0]:+.3f}  y={outfeed[1]:+.3f}")
for side in plan.sides:
    poses = ModelPoses(zone=zone, world=world_name(plan.world), side=side.name)
    try:
        at = None
        for _ in range(50):
            at = poses.position("workpiece")
            if at is not None:
                break
            __import__("time").sleep(0.2)
    finally:
        poses.close()
    where = "not found" if at is None else f"x={at[0]:+.3f}  y={at[1]:+.3f}  z={at[2]:+.3f}"
    print(f"    {side.name:<12} {where}")
PY

exit "$STATUS"
