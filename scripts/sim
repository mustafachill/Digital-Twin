#!/usr/bin/env bash
# Launch the simulated cell.
#
#   ./scripts/sim --zone cell_b              GUI (requires a display)
#   ./scripts/sim --zone cell_b --headless   no GUI — the form used by CI and by the tester agent
#   ./scripts/sim --zone cell_b --pair       both sides of a twin pair, under the pair supervisor
#
# --zone IS REQUIRED AND HAS NO DEFAULT (ADR-0055). The facility declares two
# cells: `cell_b`, the one-arm cell this project works on, and `cell_a`, the
# three-arm cell Phase 1 closed on, which is kept as a showcase and is brought up
# with `./scripts/sim --zone cell_a`. Exactly one zone runs at a time — two share
# one ROS graph and collide on the reserved `/cite/facility`, `/cite/line` and
# `/cite/twin` scopes, which are deliberately not zone-scoped.
#
# --pair requires the zone to declare `twin: {sides: pair}` in the L0 model; on an
# untwinned zone it refuses rather than inventing a second side. The two sides run
# the same launch in two environments and are joined, never sequenced (ADR-0047).
#
# Launch arguments take the same `key:=value` spelling either way, so
# `./scripts/sim --zone cell_b --pair line:=true` runs the line on both sides. A
# pair takes fewer of them than one side does: `side:=` is the supervisor's to
# decide.

# shellcheck source=scripts/_lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"

HEADLESS=0
PAIR=0
ZONE=""
PASSTHROUGH=()
# `--zone X` and `--zone=X`. A bare `zone:=X` still reaches the launch through
# PASSTHROUGH, as every other `key:=value` does, and is caught below rather than
# silently competing with the flag.
WANT_ZONE=0
for arg in "$@"; do
    if [ "$WANT_ZONE" -eq 1 ]; then
        ZONE="$arg"
        WANT_ZONE=0
        continue
    fi
    case "$arg" in
        --headless) HEADLESS=1 ;;
        --pair)     PAIR=1 ;;
        --zone)     WANT_ZONE=1 ;;
        --zone=*)   ZONE="${arg#--zone=}" ;;
        zone:=*)    ZONE="${arg#zone:=}" ;;
        -h|--help)  sed -n '2,21p' "$0"; exit 0 ;;
        *)          PASSTHROUGH+=("$arg") ;;
    esac
done

if [ "$WANT_ZONE" -eq 1 ]; then
    die "--zone needs a zone name.
  ./scripts/sim --zone cell_b   the one-arm cell
  ./scripts/sim --zone cell_a   the three-arm showcase"
fi

# Refused rather than defaulted (ADR-0055 decision 4). A default here would put
# the zone back exactly where removing it from `default_plan_path` took it from:
# somewhere nobody chose it.
if [ -z "$ZONE" ]; then
    die "--zone is required and has no default.
  ./scripts/sim --zone cell_b   the one-arm cell this project works on
  ./scripts/sim --zone cell_a   the three-arm cell Phase 1 closed on, kept as a showcase
  Exactly one zone runs at a time; see ADR-0055."
fi

# A pair is headless, and there is no other form of it to offer. Two windows of a
# cell whose names are byte-identical on both sides would be indistinguishable
# (ADR-0044, clause 1), and the compose service that carries a display carries
# one. Inspect either side with Foxglove on that side's domain instead.
if [ "$PAIR" -eq 1 ]; then
    HEADLESS=1
fi

# GUI needs display passthrough, which is a different compose service.
if [ "$HEADLESS" -eq 0 ] && ! in_container; then
    if [ "$(host_os)" = "macos" ]; then
        die "GUI simulation is not supported from macOS.
  Use --headless here and inspect the run with Foxglove, or run on the Linux workstation."
    fi
    export CITE_SERVICE=gui
fi

require_ros_env sim "$@"

if [ ! -d "${REPO_ROOT}/workspace/install" ]; then
    die "No build found. Run ./scripts/build first."
fi
source_overlay

# Captured first, then matched against a here-string rather than through a pipe.
# `grep -q` exits on its first match, which sends SIGPIPE to `ros2 pkg list`, and
# under `set -o pipefail` that turns a *successful* match into a failed pipeline.
# The visible effect was this script reporting that cite_bringup is not built
# whenever it was.
PACKAGES="$(ros2 pkg list 2>/dev/null || true)"
if ! grep -qx 'cite_bringup' <<<"$PACKAGES"; then
    warn "cite_bringup is not built yet — there is nothing to launch."
    warn "Run ./scripts/build. See CLAUDE.md §2."
    exit 0
fi

if [ "$PAIR" -eq 1 ]; then
    info "Launching both sides of the pair under the supervisor"
    # The supervisor rather than a second `ros2 launch` here: it owns the join
    # and the pair's lifetime, and a shell that started two launches would leave
    # nothing computing "the pair is up" and nothing stopping a half-pair
    # (ADR-0047, Option A).
    exec python3 -m cite_bringup.pair --headless "zone:=${ZONE}" "${PASSTHROUGH[@]}"
fi

info "Launching the simulated cell (zone=${ZONE}, headless=${HEADLESS})"
exec ros2 launch cite_bringup simulation.launch.py \
    zone:="$ZONE" \
    headless:="$([ "$HEADLESS" -eq 1 ] && echo true || echo false)" \
    "${PASSTHROUGH[@]}"
