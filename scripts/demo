#!/usr/bin/env bash
# Run the whole thing, end to end, with the windows open.
#
#   ./scripts/demo                  both sides of the paired cell, one window each
#   ./scripts/demo --headless       the same run with no windows
#   ./scripts/demo --zone cell_b    name the zone rather than letting the model choose
#
# WHAT IT DOES. It prepares the environment if it has never been prepared, brings
# up BOTH sides of the twin pair with the line running, puts one work-piece on
# each side's pick table, and watches until each has been carried to the end of
# the belt. Then it tears the pair down. Ctrl-C at any point does the same.
#
# WHAT IT IS NOT. It is a demonstration, not an instrument. It asserts nothing,
# gates nothing, and is in no CI step. `./scripts/scenario continuous_line` is
# the thing that CHECKS this behaviour; it runs headless, drives one side, and is
# what a claim about the line should cite. This run deliberately prints no gap
# between the two sides: it stops polling each box the moment it is first seen
# past the line, so its two samples are taken at different instants on a moving
# belt and their difference is poll timing rather than divergence. ADR-0065 is
# where the divergence between the two sides is actually measured.
#
# IT OPENS TWO WINDOWS AND THAT NEEDS THE GPU, WHICH IS A MEASUREMENT AND NOT A
# CAUTION. Run on 2026-09-28 while `gz sim gui` was rendering in SOFTWARE — the
# state every GUI run in this project had been in, unnoticed — two windows drove
# this 16-core host to a load average of 22.74, the counterpart's arm fell 29.7
# degrees behind its own commanded trajectory on picker_joint1 and 35.3 on
# picker_joint3 against a 0.01 rad tolerance, the controller aborted with
# GOAL_TOLERANCE_VIOLATED, `Pick` returned result code 10, and L4 stopped the
# line and asked for an operator. The same run headless, same commit, carried
# both boxes end to end with zero tolerance failures.
#
# THE FIX WAS THE GPU, NOT THE WINDOWS. `scripts/sim` now selects the NVIDIA
# vendor library for GLX when the container has it, and one windowed cell then
# runs this host at a load average of 0.80 with the GUI holding 295 MiB of VRAM.
# The mechanism by which starvation reaches an arm is in CLAUDE.md section 2 and
# needs nothing new: `gz_ros2_control`'s position path is a VELOCITY SERVO,
# converting position error to a velocity command each control cycle, so a loop
# that cannot keep up leaves the arm behind its trajectory with nothing in its
# way.
#
# NEVER ANSWER A LAGGING ARM BY WIDENING THE TOLERANCE. It is a detector
# (ADR-0036) and it did its job; a tolerance widened to absorb a starved host is
# a measurement thrown away, and CLAUDE.md forbids it in as many words. If this
# run aborts an arm on your machine, the thing to check is whether the window is
# on the GPU — `nvidia-smi` names the process — not the tolerance.
#
# IT IS SLOW AND THAT IS EXPECTED. Two simulators and two MoveIt instances share
# one machine. CLAUDE.md section 2 records that this cell runs at a fraction of
# real time once it is short of CPU, and that Gazebo's own real-time factor field
# over-reports when it is. Do not read anything into how fast it runs here.
#
# shellcheck source=scripts/_lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"

HEADLESS=0
ZONE=""
WANT_ZONE=0
# THE EMPTY ZONE IS REFUSED RATHER THAN FALLING BACK, and so is a flag or a
# launch argument standing where a name should. Both are the failures
# `./scripts/scenario` was caught by: `--zone --headless` set the zone to a flag
# AND consumed the flag, and `--zone=` looked like a caller naming a cell while
# silently getting whichever one the default resolves to. Here the fallback is
# the model's own answer, which makes a silent one harder to notice, not easier.
set_zone() { # set_zone <spelling> <value>
    case "$2" in
        "")     die "${1} needs a zone name and was given an empty zone name.
  Leave --zone off entirely to drive whichever zone the model declares paired." ;;
        -*|*:=*) die "${1} needs a zone name and was given '${2}'." ;;
    esac
    ZONE="$2"
}
for arg in "$@"; do
    if [ "$WANT_ZONE" -eq 1 ]; then
        set_zone "--zone" "$arg"; WANT_ZONE=0; continue
    fi
    case "$arg" in
        --headless) HEADLESS=1 ;;
        --zone)     WANT_ZONE=1 ;;
        --zone=*)   set_zone "--zone=" "${arg#--zone=}" ;;
        -h|--help)  sed -n '2,50p' "$0"; exit 0 ;;
        *)          die "unknown argument '${arg}'. Try --help." ;;
    esac
done
[ "$WANT_ZONE" -eq 0 ] || die "--zone needs a zone name."

# ---------------------------------------------------------------- on the host
if ! in_container; then
    # REFUSED ON A DIRTY HOST, for two reasons and not one. A cell left up by an
    # earlier run answers on the same domain, so this one would be driving
    # somebody else's simulation; and `exec_in_container` attaches to a running
    # container with `compose exec`, which does NOT run the image's entrypoint,
    # so the overlay would be unsourced. CLAUDE.md §2 records a whole set of
    # test figures taken that way and thrown out.
    #
    # IT IS HOST-SIDE ONLY, AND SAYING SO IS THE POINT. `./scripts/enter dev
    # ./scripts/demo` skips this whole block, so a second pair can still be
    # started beside a running one, on the same ROS_DOMAIN_ID and the same
    # GZ_PARTITION. `require_domain` and `require_gz_partition` do not catch it:
    # they check that a process carries the RIGHT identifiers, not that nobody
    # else is already there. A guard a reader believes is total is worse than no
    # guard, which is why this paragraph exists rather than a wider claim.
    stop_this_checkouts_containers
    if [ "$(docker ps -q 2>/dev/null | wc -l)" -ne 0 ]; then
        die "a container of another checkout is running, and this would share its ROS
  domain and Gazebo partition. Stop it first:  docker ps   then   docker rm -f <id>"
    fi

    if [ ! -d "${REPO_ROOT}/.venv" ]; then
        step "No environment yet — preparing one. This happens once."
        "${REPO_ROOT}/scripts/bootstrap"
    fi

    if [ "$HEADLESS" -eq 0 ]; then
        if [ "$(host_os)" = "macos" ]; then
            die "the windows need an X display, which macOS does not pass through.
  Run ./scripts/demo --headless here, or run this on the Linux workstation."
        fi
        [ -n "${DISPLAY:-}" ] || die "DISPLAY is not set, so there is nowhere to put the windows.
  Run ./scripts/demo --headless instead."
        export CITE_SERVICE=gui
    fi
fi

require_ros_env demo "$@"

# ----------------------------------------------------------- in the container
if [ ! -d "${REPO_ROOT}/workspace/install" ]; then
    step "Nothing is built yet — building. This happens once, and takes a while."
    "${REPO_ROOT}/scripts/build"
fi
source_overlay

if [ -z "$ZONE" ]; then
    # Asked for rather than defaulted here: which zone is paired is an L0 fact,
    # and `cite_bringup.demo` reads it out of the generated plans. A default in
    # this file would be the second place stating it (P1).
    ZONE="$(python3 -m cite_bringup.demo --print-zone)" \
        || die "could not work out which zone is paired. Name one with --zone."
fi

PAIR_LOG="$(mktemp -t cite-demo-pair.XXXXXX.log)"
PAIR_PID=""
TAIL_PID=""
DEMO_PID=""

# Invoked by the trap below and never by name, which shellcheck cannot see.
# shellcheck disable=SC2329
teardown() {
    # ONLY EXIT IS CLEARED, AND THE OTHER TWO ARE RE-ARMED TO SAY "STILL
    # STOPPING". Teardown here is slow by design — the supervisor stops the
    # boundary, then each side, and each side's own per-process ceilings are tens
    # of seconds — so an operator WILL press Ctrl-C again. Clearing INT at this
    # point let the second one kill this shell, and `cite_bringup.pair` starts
    # every side with `start_new_session=True`, so the signal reaches nothing:
    # two launch trees, two Gazebo servers and two controller managers would
    # survive on this checkout's domains, and the next bring-up then fails
    # pointing somewhere useless.
    trap - EXIT
    trap 'warn "still stopping — the supervisor is working through its own ceilings"' INT TERM
    if [ -n "$TAIL_PID" ]; then kill "$TAIL_PID" 2>/dev/null || true; fi
    if [ -n "$DEMO_PID" ]; then kill "$DEMO_PID" 2>/dev/null || true; fi
    if [ -n "$PAIR_PID" ] && kill -0 "$PAIR_PID" 2>/dev/null; then
        step "Stopping the pair"
        # SIGINT and not SIGKILL: the supervisor stops the boundary first and
        # then each side, and a killed supervisor leaves two half-pairs behind
        # (ADR-0047). It is given as long as its own ceilings need.
        #
        # NOTHING HERE COMMANDS A BELT TO ZERO, and that is worth one line rather
        # than being discovered. The simulated belts stop because Gazebo dies with
        # the launch and there is no belt left to run; a physical belt is a VFD
        # and A SETPOINT PERSISTS (ADR-0038). So a clean teardown here is evidence
        # about the simulated half only, and this script is the first thing in the
        # tree that makes "start the line, then Ctrl-C it" a one-command gesture.
        #
        # THIS WAIT IS NOT BOUNDED, AND THAT IS STATED RATHER THAN FIXED.
        # `cite_bringup/pair.py` records a hazard of its own — a signal handler's
        # `Queue.put` can deadlock the supervisor against its own join, with its
        # ceiling unable to fire because the stuck call is what enforces it — and
        # this wait would then never return. Bounding it means escalating to the
        # supervisor's process group, which is machinery for a failure nobody has
        # observed. What protects the operator meanwhile is the re-armed trap
        # above: a second Ctrl-C says so instead of orphaning two cells.
        kill -INT "$PAIR_PID" 2>/dev/null || true
        wait "$PAIR_PID" 2>/dev/null || true
    fi
    # Said rather than left to be discovered: this path is inside the container,
    # which goes when this command does. It is not written into the repository on
    # purpose — `tools/cite_tools/tree.py` skips `.git` and nothing else, so a
    # file left in the checkout would join the English walk and move the count
    # `./scripts/lint` reports. CLAUDE.md section 2 records a whole reading
    # retired for exactly that.
    ok "the cell is down. Everything it printed is above; its log was"
    ok "${PAIR_LOG}, inside the container."
}
trap teardown INT TERM HUP EXIT

step "Bringing up both sides of ${ZONE}, with the line running"
if [ "$HEADLESS" -eq 1 ]; then
    "${REPO_ROOT}/scripts/sim" --zone "$ZONE" --pair --headless line:=true \
        > "$PAIR_LOG" 2>&1 &
else
    "${REPO_ROOT}/scripts/sim" --zone "$ZONE" --pair line:=true \
        > "$PAIR_LOG" 2>&1 &
fi
PAIR_PID=$!
tail -n +1 -f "$PAIR_LOG" & TAIL_PID=$!

# THE JOIN IS AN EVENT, NOT A DURATION (P4). What is waited for is the token the
# supervisor prints once BOTH sides have answered their own readiness witness and
# the twin boundary is up; the loop below only polls for that line having
# appeared, and gives up if the pair dies or never announces. Nothing here sleeps
# for a guessed bring-up time.
info "Waiting for both sides to announce readiness"
READY=0
for _ in $(seq 1 180); do
    if grep -q 'CITE_BOUNDARY_READY' "$PAIR_LOG" 2>/dev/null; then READY=1; break; fi
    if ! kill -0 "$PAIR_PID" 2>/dev/null; then break; fi
    sleep 2
done
[ "$READY" -eq 1 ] || die "the pair never announced that it was ready. Its log is ${PAIR_LOG}"

kill "$TAIL_PID" 2>/dev/null || true
TAIL_PID=""
ok "both sides are up"

step "Putting a work-piece on each side's pick table"
STATUS=0

# THE WATCHER IS BACKGROUNDED SO THAT A STOPPED LINE ENDS THE RUN, and that is
# not a style choice. When a station escalates, `line_orchestrator` latches the
# fault and exits 1, `simulation.launch.py` treats that as fatal for its side,
# and the supervisor ends the pair — but `cite_bringup.demo` cannot see any of
# it. It subscribes to no `LineState`, and it deliberately may not: the two sides
# are on two ROS domains and ADR-0044 clause 3 makes L5 the only component
# allowed endpoints in both. Left in the foreground it would poll a dead
# partition for the rest of its 900 s ceiling and then report "DID NOT ARRIVE",
# naming no fault — which is exactly the shape `continuous_line` was caught in,
# spending a full leg ceiling before accusing the milestone it happened to be
# waiting for.
#
# What this shell CAN see is the supervisor, so that is what it watches.
python3 -u -m cite_bringup.demo --zone "$ZONE" &
DEMO_PID=$!
while kill -0 "$DEMO_PID" 2>/dev/null; do
    if ! kill -0 "$PAIR_PID" 2>/dev/null; then
        err "the pair ended before the work-pieces arrived."
        # The diagnosis rather than the exit code: a station that escalated says
        # so in one line, and a reader sent to a log file reads none of it.
        grep -aE "escalated to an operator|is blocked and needs an operator|the line stopped at" \
             "$PAIR_LOG" | tail -5 >&2 || true
        err "The full log is ${PAIR_LOG}, inside this container."
        kill "$DEMO_PID" 2>/dev/null || true
        STATUS=1
        break
    fi
    sleep 2
done
# Captured into its own variable rather than read as `$?` after a test, which
# would be the test's status and not the watcher's. A `STATUS` already set by the
# branch above wins, because "the pair ended" is the more useful diagnosis than
# whatever the watcher returned on its way out.
WAIT_RC=0
wait "$DEMO_PID" 2>/dev/null || WAIT_RC=$?
if [ "$STATUS" -eq 0 ]; then
    STATUS="$WAIT_RC"
fi
DEMO_PID=""

exit "$STATUS"
