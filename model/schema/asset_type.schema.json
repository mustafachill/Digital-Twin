          "title": "Ixz",
          "type": "number"
        },
        "iyy": {
          "exclusiveMinimum": 0.0,
          "title": "Iyy",
          "type": "number"
        },
        "iyz": {
          "default": 0.0,
          "title": "Iyz",
          "type": "number"
        },
        "izz": {
          "exclusiveMinimum": 0.0,
          "title": "Izz",
          "type": "number"
        },
        "mass_kg": {
          "exclusiveMinimum": 0.0,
          "title": "Mass Kg",
          "type": "number"
        }
      },
      "required": [
        "mass_kg",
        "ixx",
        "iyy",
        "izz"
      ],
      "title": "Inertial",
      "type": "object"
    },
    "Kinematics": {
