            "cylinder"
          ],
          "title": "Kind",
          "type": "string"
        },
        "length_m": {
          "exclusiveMinimum": 0.0,
          "title": "Length M",
          "type": "number"
        },
        "radius_m": {
          "exclusiveMinimum": 0.0,
          "title": "Radius M",
          "type": "number"
