{
  "$defs": {
    "AssetType": {
      "additionalProperties": false,
      "description": "A reusable definition, instantiated many times with different prefixes.",
      "properties": {
        "category": {
          "enum": [
            "robot",
            "end_effector",
            "conveyor",
            "sensor",
            "fixture",
            "workpiece"
          ],
          "title": "Category",
          "type": "string"
        },
        "control": {
          "anyOf": [
            {
              "$ref": "#/$defs/ControlSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "controllers": {
          "items": {
            "$ref": "#/$defs/ControllerSpec"
          },
          "title": "Controllers",
          "type": "array"
        },
        "description": {
          "$ref": "#/$defs/DescriptionSpec"
        },
        "frames": {
          "items": {
            "$ref": "#/$defs/NamedFrame"
          },
          "title": "Frames",
          "type": "array"
        },
        "grasp": {
          "anyOf": [
            {
              "$ref": "#/$defs/GraspSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hardware_backends": {
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "$ref": "#/$defs/HardwareBackend"
            }
          },
          "title": "Hardware Backends",
          "type": "object"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "kinematics": {
          "anyOf": [
            {
              "$ref": "#/$defs/Kinematics"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "planning": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanningSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "vendor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vendor"
        }
      },
      "required": [
        "id",
        "category",
        "description"
      ],
      "title": "AssetType",
      "type": "object"
    },
    "Body": {
      "additionalProperties": false,
      "description": "Geometry for a part we author ourselves — a conveyor, a table, a pedestal.\n\nVisual and collision are separate fields with no default linking them,\ndeliberately. L1 calls reusing a dense visual mesh as collision geometry the\nsingle most consequential mistake in that layer: it destroys real-time factor\nand produces contact behaviour nobody can explain. Making them separate\nrequired fields means doing it is a visible choice, not an omission.",
      "properties": {
        "collision": {
          "discriminator": {
            "mapping": {
              "box": "#/$defs/BoxGeometry",
              "cylinder": "#/$defs/CylinderGeometry",
              "mesh": "#/$defs/MeshGeometry"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/BoxGeometry"
            },
            {
              "$ref": "#/$defs/CylinderGeometry"
            },
            {
              "$ref": "#/$defs/MeshGeometry"
            }
          ],
          "title": "Collision"
        },
        "inertial": {
          "$ref": "#/$defs/Inertial"
        },
        "material": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Material"
        },
        "visual": {
          "discriminator": {
            "mapping": {
              "box": "#/$defs/BoxGeometry",
              "cylinder": "#/$defs/CylinderGeometry",
              "mesh": "#/$defs/MeshGeometry"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/BoxGeometry"
            },
            {
              "$ref": "#/$defs/CylinderGeometry"
            },
            {
              "$ref": "#/$defs/MeshGeometry"
            }
          ],
          "title": "Visual"
        }
      },
      "required": [
        "visual",
        "collision",
        "inertial"
      ],
      "title": "Body",
      "type": "object"
    },
    "BoxGeometry": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "box",
          "default": "box",
          "enum": [
            "box"
          ],
          "title": "Kind",
          "type": "string"
        },
        "size_m": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
