<?xml version="1.0"?>
<!--
  Spawnable Robot URDF Template
  
  This xacro file allows spawning xArm robots with unique prefixes.
  Each robot can be spawned with its own namespace to avoid conflicts.
  
  Usage:
    xacro spawnable_robot.urdf.xacro robot_id:=robot_1 dof:=5 add_gripper:=true
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fleet_robot">

  <!-- ============================================ -->
  <!-- Arguments -->
  <!-- ============================================ -->
  
  <!-- Robot identification -->
  <xacro:arg name="robot_id" default="robot_1"/>
  <xacro:arg name="dof" default="5"/>
  
  <!-- Hardware configuration -->
  <xacro:arg name="add_gripper" default="true"/>
  <xacro:arg name="gripper_type" default="xarm_gripper"/>
  
  <!-- ros2_control configuration -->
  <xacro:arg name="ros2_control_plugin" default="gazebo_ros2_control/GazeboSystem"/>
  <xacro:arg name="hw_ns" default="xarm"/>
  
  <!-- Control modes -->
  <xacro:arg name="effort_control" default="false"/>
  <xacro:arg name="velocity_control" default="false"/>
  <xacro:arg name="limited" default="false"/>
  
  <!-- ============================================ -->
  <!-- Properties from arguments -->
  <!-- ============================================ -->
  
  <xacro:property name="robot_id" value="$(arg robot_id)"/>
  <xacro:property name="dof" value="$(arg dof)"/>
  <xacro:property name="prefix" value="${robot_id}_"/>
  <xacro:property name="add_gripper" value="$(arg add_gripper)"/>
  <xacro:property name="gripper_type" value="$(arg gripper_type)"/>
  <xacro:property name="ros2_control_plugin" value="$(arg ros2_control_plugin)"/>
  <xacro:property name="hw_ns" value="$(arg hw_ns)"/>
  <xacro:property name="effort_control" value="$(arg effort_control)"/>
  <xacro:property name="velocity_control" value="$(arg velocity_control)"/>
  <xacro:property name="limited" value="$(arg limited)"/>
  
  <!-- ============================================ -->
  <!-- Include base xArm URDF -->
  <!-- ============================================ -->
  
  <!-- Include xArm description based on DOF -->
  <xacro:if value="${dof == 5}">
    <xacro:include filename="$(find xarm_description)/urdf/xarm5/xarm5.urdf.xacro"/>
    <xacro:xarm5_urdf
      prefix="${prefix}"
      hw_ns="${hw_ns}"
      limited="${limited}"
      effort_control="${effort_control}"
      velocity_control="${velocity_control}"
      add_gripper="${add_gripper}"
      ros2_control_plugin="${ros2_control_plugin}"
    />
  </xacro:if>
  
  <xacro:if value="${dof == 6}">
    <xacro:include filename="$(find xarm_description)/urdf/xarm6/xarm6.urdf.xacro"/>
    <xacro:xarm6_urdf
      prefix="${prefix}"
      hw_ns="${hw_ns}"
      limited="${limited}"
      effort_control="${effort_control}"
      velocity_control="${velocity_control}"
      add_gripper="${add_gripper}"
      ros2_control_plugin="${ros2_control_plugin}"
    />
  </xacro:if>
  
  <xacro:if value="${dof == 7}">
    <xacro:include filename="$(find xarm_description)/urdf/xarm7/xarm7.urdf.xacro"/>
    <xacro:xarm7_urdf
      prefix="${prefix}"
      hw_ns="${hw_ns}"
      limited="${limited}"
      effort_control="${effort_control}"
      velocity_control="${velocity_control}"
      add_gripper="${add_gripper}"
      ros2_control_plugin="${ros2_control_plugin}"
    />
  </xacro:if>

</robot>







