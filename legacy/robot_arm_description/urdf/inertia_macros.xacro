<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Inertia calculation macros -->

  <!-- Cylinder inertia (aligned with z-axis) -->
  <xacro:macro name="cylinder_inertia" params="mass radius length">
    <inertia
      ixx="${mass * (3 * radius * radius + length * length) / 12.0}"
      ixy="0.0"
      ixz="0.0"
      iyy="${mass * (3 * radius * radius + length * length) / 12.0}"
      iyz="0.0"
      izz="${mass * radius * radius / 2.0}"/>
  </xacro:macro>

  <!-- Box inertia -->
  <xacro:macro name="box_inertia" params="mass x y z">
    <inertia
      ixx="${mass * (y * y + z * z) / 12.0}"
      ixy="0.0"
      ixz="0.0"
      iyy="${mass * (x * x + z * z) / 12.0}"
      iyz="0.0"
      izz="${mass * (x * x + y * y) / 12.0}"/>
  </xacro:macro>

  <!-- Sphere inertia -->
  <xacro:macro name="sphere_inertia" params="mass radius">
    <inertia
      ixx="${2.0 * mass * radius * radius / 5.0}"
      ixy="0.0"
      ixz="0.0"
      iyy="${2.0 * mass * radius * radius / 5.0}"
      iyz="0.0"
      izz="${2.0 * mass * radius * radius / 5.0}"/>
  </xacro:macro>

</robot>



