<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>assembly_line_sensors</name>
  <version>1.0.0</version>
  <description>
    Sensor models and configuration for the assembly line.
    Includes break beam sensors, proximity sensors, and RealSense D435 camera integration.
  </description>

  <author email="mustafacil@example.com">Mustafa Cil</author>
  <maintainer email="mustafacil@example.com">Mustafa Cil</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gazebo_ros</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>xacro</depend>
  <!-- realsense_gazebo_plugin optional - can use gazebo_ros camera instead -->

  <exec_depend>gazebo_ros_pkgs</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/models"/>
  </export>
</package>

