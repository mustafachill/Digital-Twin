<?xml version="1.0" ?>
<!--
  Proximity Sensor for Assembly Line
  IR-style proximity sensor for distance measurement.
-->
<sdf version="1.6">
  <model name="proximity_sensor">
    <static>true</static>
    
    <link name="sensor_link">
      <pose>0 0 0 0 0 0</pose>
      
      <!-- Sensor housing -->
      <visual name="housing_visual">
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
      
      <collision name="housing_collision">
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
      </collision>
      
      <!-- Sensor face (lens) -->
      <visual name="lens_visual">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.01</radius>
            <length>0.005</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.1 0.1 1</ambient>
          <diffuse>0.9 0.2 0.2 1</diffuse>
          <emissive>0.3 0.0 0.0 1</emissive>
        </material>
      </visual>
      
      <!-- Proximity sensor (ray) -->
      <sensor name="proximity" type="ray">
        <pose>0 0 0.025 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <visualize>true</visualize>
        
        <ray>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.02</min>
            <max>0.5</max>
            <resolution>0.001</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.005</stddev>
          </noise>
        </ray>
        
        <plugin name="proximity_sensor_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>station</namespace>
            <remapping>~/out:=proximity</remapping>
          </ros>
          <output_type>sensor_msgs/Range</output_type>
          <frame_name>proximity_frame</frame_name>
        </plugin>
      </sensor>
    </link>
    
  </model>
</sdf>

