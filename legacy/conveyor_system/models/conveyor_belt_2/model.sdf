<?xml version="1.0" ?>
<!--
  2-meter Conveyor Belt for Parallel Multi-Robot Assembly Line
  Length: 2 meters
  Width: 0.45 meters
  Based on IFRA-Cranfield conveyor belt plugin.
-->
<sdf version="1.6">
  <model name="conveyor_belt_2">

    <!-- Static frame/structure of the conveyor -->
    <model name="conveyorbelt_fixed">
      <static>true</static>
      
      <!-- Main belt structure -->
      <link name="belt_visual">
        <pose>0 0 0 0 0 0</pose>
        
        <!-- Belt frame - left side -->
        <visual name="frame_left">
          <pose>-0.25 0 0.4 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 2.0 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
        <collision name="frame_left_collision">
          <pose>-0.25 0 0.4 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 2.0 0.8</size>
            </box>
          </geometry>
        </collision>
        
        <!-- Belt frame - right side -->
        <visual name="frame_right">
          <pose>0.25 0 0.4 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 2.0 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
        <collision name="frame_right_collision">
          <pose>0.25 0 0.4 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 2.0 0.8</size>
            </box>
          </geometry>
        </collision>
        
        <!-- Legs -->
        <visual name="leg_front_left">
          <pose>-0.22 -0.9 0.2 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.4</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        
        <visual name="leg_front_right">
          <pose>0.22 -0.9 0.2 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.4</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        
        <visual name="leg_back_left">
          <pose>-0.22 0.9 0.2 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.4</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        
        <visual name="leg_back_right">
          <pose>0.22 0.9 0.2 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.4</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        
        <!-- Middle legs for support -->
        <visual name="leg_mid_left">
          <pose>-0.22 0 0.2 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.4</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        
        <visual name="leg_mid_right">
          <pose>0.22 0 0.2 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.4</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        
        <!-- Belt surface visual (static part) -->
        <visual name="belt_surface">
          <pose>0 0 0.795 0 0 0</pose>
          <geometry>
            <box>
              <size>0.45 2.0 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Moving belt surface -->
    <model name="conveyorbelt_moving">
      <allow_auto_disable>0</allow_auto_disable>
      <static>false</static>
      <pose>0 0 0.8 0 0 0</pose>

      <link name="belt_moving">
        <inertial>
          <mass>50.0</mass>
          <inertia>
            <ixx>0.0</ixx>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyy>0.0</iyy>
            <iyz>0.0</iyz>
            <izz>0.0</izz>
          </inertia>
        </inertial>
        
        <collision name="belt_collision">
          <geometry>
            <box>
              <size>0.42 2.0 0.00001</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100.0</mu>
                <mu2>100.0</mu2>
              </ode>
              <torsional>
                <coefficient>1000.0</coefficient>
                <patch_radius>0.1</patch_radius>
              </torsional>
            </friction>
          </surface>
        </collision>
      </link>
    </model>

    <!-- Joint connecting moving and fixed parts -->
    <joint name="belt_joint" type="prismatic">
      <parent>conveyorbelt_fixed::belt_visual</parent>
      <child>conveyorbelt_moving::belt_moving</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>0.0</lower>
          <upper>0.01</upper>
        </limit>
      </axis>
    </joint>

    <!-- ROS2 Conveyor Belt Plugin -->
    <plugin name="ros2_conveyorbelt_plugin" filename="libros2_conveyorbelt_plugin.so">
      <ros>
        <namespace>conveyor_belt_2</namespace>
      </ros>
      <max_velocity>0.5</max_velocity>
      <publish_rate>100</publish_rate>
    </plugin>

  </model>
</sdf>


