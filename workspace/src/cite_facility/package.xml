<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypelang="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cite_facility</name>
  <version>0.1.0</version>
  <description>
    Runtime access to the artifacts generated from the L0 facility model.

    This package never reads model/. L0 is explicit that a running system does not
    read the model — it reads what was generated from it. cite_tools turns the
    model into artifacts, on any machine, with no ROS; this package turns those
    artifacts into runtime facts, in the robot, with no model.
  </description>
  <maintainer email="cite@shsu.edu">CITE Digital Twin</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>cite_interfaces</depend>
  <depend>geometry_msgs</depend>
  <!-- The planning-scene loader speaks MoveIt's collision-object contract. These
       are message packages, not MoveIt itself: nothing here plans, and nothing
       here links against move_group. -->
  <depend>moveit_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>cite_generated</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <!-- Without this, ament_lint_auto_find_test_dependencies() finds no linters,
       registers no tests, and the lint gate reports success having checked
       nothing. -->
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
