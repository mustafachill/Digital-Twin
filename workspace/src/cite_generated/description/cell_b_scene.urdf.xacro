    <inertial>
      <!-- The body's pose names the point it stands on, so the mass sits half a
           height above the link origin. `com_m` is measured from the box centre
           and the tensor beside it is centroidal; declaring both at the foot
           states a centroidal tensor about a point up to 0.3 m from the mass. -->
      <origin xyz="0 0 0.3" rpy="0 0 0"/>
      <mass value="80"/>
      <inertia ixx="6.6667" ixy="0"
               ixz="0" iyy="16.4167"
               iyz="0" izz="18.2833"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.3" rpy="0 0 0"/>
      <geometry><mesh filename="file://$(find cite_description)/meshes/visual/tables/work_table_1450x800.glb" scale="1 1 1"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.3" rpy="0 0 0"/>
      <geometry><box size="1.45 0.8 0.6"/></geometry>
    </collision>
  </link>
  <joint name="infeed_table_anchor" type="fixed">
