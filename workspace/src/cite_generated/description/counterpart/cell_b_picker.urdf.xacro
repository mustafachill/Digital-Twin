<?xml version="1.0"?>
<!-- GENERATED by cite-model. DO NOT EDIT.
     Source:     model/
     Regenerate: ./scripts/validate-model, passing the write flag.
     A hand edit here is a Critical review finding (ADR-0004) and is detected by
     ./scripts/validate-model, which diffs this tree against a fresh generator run. -->
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="picker">

  <!-- One description per arm, loaded by the controller manager of a side that
       runs no simulator: the hardware component it names is the machine
       (ADR-0070). Its names, and the namespace /cite/<zone>/<asset_id> it is
       loaded in, are the simulated side's. -->

  <!-- The root. Placed in the world at spawn time, and tied to cite_world by the
       generated static transform table, so this description states no world
       coordinate of its own. -->
  <!-- With mass here, and only on an arm that rides a track: the joint under
       this link is not fixed, and the URDF-to-SDF converter drops a massless
       link that has a moving child, together with the world anchor below that
       names it. It is welded to the world, so the value moves nothing. -->
  <link name="picker_mount">
    <inertial>
      <mass value="1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- The linear track this arm rides (ADR-0067). Its rail is a body in the
       scene; its one joint is HERE, between the mount and the carriage the arm's
       base is bolted to, so robot_state_publisher, MoveIt's robot state and its
       collision checks all see where the arm really is. The mount stands where
       the carriage is at stroke zero, and the axis is stated in the mount's own
       frame, derived from the track type's direction.

       The carriage has mass because a massless link between two joints is
       dropped by the URDF-to-SDF converter, and the axis with it. Its collision
       box is its visual box: the plate rides 5 mm above the rail's top face, so
       it touches nothing at rest, and it is what an arm link swinging down past
       the carriage is checked against. The arm's own base is bolted to its top
       face, and the generated SRDF disables that one adjacent pair. -->
  <link name="picker_track_carriage">
    <inertial>
      <origin xyz="0 0 -0.0025" rpy="0 0 0"/>
      <mass value="3"/>
      <inertia ixx="0.00640625" ixy="0" ixz="0" iyy="0.01000625" iyz="0" izz="0.0164"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.0025" rpy="0 0 0"/>
      <geometry><box size="0.2 0.16 0.005"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.0025" rpy="0 0 0"/>
      <geometry><box size="0.2 0.16 0.005"/></geometry>
    </collision>
  </link>
  <joint name="picker_track_joint" type="prismatic">
    <parent link="picker_mount"/>
    <child link="picker_track_carriage"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.7" velocity="1" effort="500"/>
  </joint>

  <xacro:include filename="$(find xarm_description)/urdf/xarm_device_macro.xacro"/>
  <xacro:xarm_device
      add_gripper="true"
      attach_rpy="0 0 0"
      attach_to="picker_track_carriage"
      attach_xyz="0 0 0"
      collision_mesh_path="package://cite_description/meshes/collision/xarm5/convex_hull"
      create_attach_link="false"
      dof="5"
      effort_control="false"
      gripper_max_drive_rate_rad_s="1"
      hw_ns="picker"
      limited="false"
      load_gazebo_plugin="false"
      mesh_suffix="stl"
      model1300="false"
      prefix="picker_"
      robot_ip="$(arg robot_ip)"
      robot_type="xarm"
      ros2_control_plugin="uf_robot_hardware/UFRobotSystemHardware"
      velocity_control="false"
  />

  <!-- Bolt the arm to the world.

       `create_attach_link` is false and `picker_mount` is not the name
       the URDF-to-SDF converter anchors on, so without this the arm's root is a
       free rigid body standing on its pedestal by contact friction alone. Joint
       reaction torques slide or tip it, and the symptom — base drift — reads as
       a calibration fault.

       The joint lives inside a `gazebo` block rather than as a URDF joint to a
       link named `world`, and that placement is the whole point: a URDF `world`
       link would make `robot_state_publisher` publish `world` -> mount as a
       second parent for a frame the generated static transform table already
       parents to `cite_world`. One frame, two parents, intermittently wrong.
       Inside `gazebo` the converter sees it and TF never does.

       The joint carries no pose. Where the arm stands is stated once, by the
       spawn pose in the bring-up plan; a pose here would apply it twice. -->
  <gazebo>
    <joint name="picker_mount_world_anchor" type="fixed">
      <parent>world</parent>
      <child>picker_mount</child>
    </joint>
  </gazebo>
</robot>
