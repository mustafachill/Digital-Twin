<?xml version="1.0"?>
<!-- GENERATED by cite-model. DO NOT EDIT.
     Source:     model/
     Regenerate: ./scripts/validate-model, passing the write flag.
     A hand edit here is a Critical review finding (ADR-0004) and is detected by
     ./scripts/validate-model, which diffs this tree against a fresh generator run. -->
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="arm_3">

  <!-- One description per arm, spawned as its own Gazebo model.
       gz_ros2_control attaches to a MODEL, and the controller manager it creates
       claims every ros2_control component in that model's description. With all
       three arms in one model, all three managers claimed all eighteen joints and
       wrote to them every cycle. Splitting the arms into separate models gives
       each manager exactly its own hardware — and keeps the namespace
       /cite/<zone>/<asset_id> that the naming scheme requires. -->

  <!-- The root. Placed in the world at spawn time, and tied to cite_world by the
       generated static transform table, so this description states no world
       coordinate of its own. -->
  <link name="arm_3_mount"/>

  <xacro:include filename="$(find xarm_description)/urdf/xarm_device_macro.xacro"/>
  <xacro:xarm_device
      add_gripper="true"
      attach_rpy="0 0 0"
      attach_to="arm_3_mount"
      attach_xyz="0 0 0"
      create_attach_link="false"
      dof="5"
      effort_control="false"
      hw_ns="arm_3"
      limited="false"
      load_gazebo_plugin="false"
      mesh_suffix="stl"
      model1300="false"
      prefix="arm_3_"
      robot_type="xarm"
      ros2_control_plugin="gz_ros2_control/GazeboSimSystem"
      velocity_control="false"
  />

  <!-- Simulated grasping by attachment (ADR-0023). A simulation fidelity aid,
       NOT a control path: nothing above ros2_control knows it exists. The Grasp
       skill commands the gripper's controller and nothing else, in simulation
       and on hardware alike; this plugin observes the result of that command
       inside the simulator, exactly as the physical world would.

       The cost is stated rather than hidden: a grasp that would slip in reality
       holds here, so no claim about grasp reliability can rest on this. -->
  <gazebo>
    <plugin filename="cite_grasp_attachment" name="cite_simulation::GraspAttachment">
      <attach_link>arm_3_left_finger</attach_link>
      <drive_joint>arm_3_drive_joint</drive_joint>
      <closed_threshold_rad>0.3</closed_threshold_rad>
      <open_threshold_rad>0.15</open_threshold_rad>
      <graspable>workpiece</graspable>
    </plugin>
  </gazebo>

  <!-- Bolt the arm to the world.

       `create_attach_link` is false and `arm_3_mount` is not the name
       the URDF-to-SDF converter anchors on, so without this the arm's root is a
       free rigid body standing on its pedestal by contact friction alone. Joint
       reaction torques slide or tip it, and the symptom — base drift — reads as
       a calibration fault.

       The joint lives inside a `gazebo` block rather than as a URDF joint to a
       link named `world`, and that placement is the whole point: a URDF `world`
       link would make `robot_state_publisher` publish `world` -> mount as a
       second parent for a frame the generated static transform table already
       parents to `cite_world`. One frame, two parents, intermittently wrong.
       Inside `gazebo` the converter sees it and TF never does.

       The joint carries no pose. Where the arm stands is stated once, by the
       spawn pose in the bring-up plan; a pose here would apply it twice. -->
  <gazebo>
    <joint name="arm_3_mount_world_anchor" type="fixed">
      <parent>world</parent>
      <child>arm_3_mount</child>
    </joint>
  </gazebo>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find cite_generated)/control/cell_a_arm_3_controllers.yaml</parameters>
      <ros>
        <namespace>/cite/cell_a/arm_3</namespace>
      </ros>
    </plugin>
  </gazebo>
</robot>
