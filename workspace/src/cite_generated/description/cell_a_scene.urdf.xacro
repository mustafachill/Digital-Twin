           height above the link origin. `com_m` is measured from the box centre
           and the tensor beside it is centroidal; declaring both at the foot
           states a centroidal tensor about a point up to 0.3 m from the mass. -->
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.00033333" ixy="0"
               ixz="0" iyy="0.00033333"
