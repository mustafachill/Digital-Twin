<?xml version="1.0"?>
<!-- GENERATED by cite-model. DO NOT EDIT.
     Source:     model/
     Regenerate: ./scripts/validate-model, passing the write flag.
     A hand edit here is a Critical review finding (ADR-0004) and is detected by
     ./scripts/validate-model, which diffs this tree against a fresh generator run. -->
<!-- The operator window (ADR-0074): the plant's window of a paired zone, framed
     by the operator console's panel. Harmonic's default GUI configuration
     (gz-sim8, gui/gui.config) less every tool that edits the world or its run -
     Spawn, Shapes, Lights, TransformControl, CopyPaste, Screenshot, the entity
     context menu and its VisualizationCapabilities, WorldControl and
     WorldStats - so the world cannot be edited from the operator window, and
     less SelectEntities, whose left-click selection left a box on the scene
     that nothing in this window uses. Sim
     time and RTF are in the panel's header. The window is dark, its menus are
     hidden, and the panel hides gz-gui's title toolbar and maximizes the window
     when it is shown. The 3D view's camera_pose is derived from where L0 places
     this zone's assets (generate/gui.py). A developer who needs the editing
     tools runs ./scripts/sim on its own. -->

<!-- Quick start dialog -->
<dialog name="quick_start" show_again="true"/>

<!-- Window -->
<window>
  <!-- The operator display's primary size; the panel maximizes the window. -->
  <width>1920</width>
  <height>1080</height>
  <style
    material_theme="Dark"
    material_primary="DeepOrange"
    material_accent="LightBlue"
    toolbar_color_light="#f3f3f3"
    toolbar_text_color_light="#111111"
    toolbar_color_dark="#414141"
    toolbar_text_color_dark="#f3f3f3"
    plugin_toolbar_color_light="#bbdefb"
    plugin_toolbar_text_color_light="#111111"
    plugin_toolbar_color_dark="#607d8b"
    plugin_toolbar_text_color_dark="#eeeeee"
  />
  <menus>
    <drawer visible="false"/>
    <plugins visible="false"/>
  </menus>
  <dialog_on_exit>true</dialog_on_exit>
</window>

<!-- GUI plugins -->

<!-- 3D scene -->
<plugin filename="MinimalScene" name="3D View">
  <gz-gui>
    <title>3D View</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="string" key="state">docked</property>
  </gz-gui>

  <engine>ogre2</engine>
  <scene>scene</scene>
  <ambient_light>0.4 0.4 0.4</ambient_light>
  <!-- The operator window's control-room background (ADR-0074). -->
  <background_color>0.12 0.15 0.19</background_color>
  <camera_pose>0.88 1.24756522 1.84284919 0 0.575958653 1.57079633</camera_pose>
</plugin>

<!-- Plugins that add functionality to the scene -->
<plugin filename="GzSceneManager" name="Scene Manager">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>
<plugin filename="InteractiveViewControl" name="Interactive view control">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>
<plugin filename="CameraTracking" name="Camera Tracking">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>
<plugin filename="MarkerManager" name="Marker manager">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>


<!-- The operator console's panel (ADR-0071 decision 5): `CellConsole`, from
     cite_console_gui, which puts its own library on GZ_GUI_PLUGIN_PATH. Only on
     the plant's window of a paired zone (generate/gui.py). It holds no logic: it
     shows the console's latched state and sends requests, and every refusal is
     the console's. Each element below is one name the console serves, by the
     key the plan's `console:` block states it under. It frames the 3D view
     (ADR-0074): anchored to all four of its edges, with a transparent card and
     no title bar, so that it carries no close button that would take the Stop
     button away with it; its own QML leaves the middle empty and lets the
     mouse through there to the scene. -->
<plugin filename="CellConsole" name="Cell console">
  <gz-gui>
    <title>Cell console</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="bool" key="resizable">false</property>
    <property type="string" key="cardBackground">#00000000</property>
    <property type="double" key="z">2</property>
    <property type="string" key="state">floating</property>
    <anchors target="3D View">
      <line own="left" target="left"/>
      <line own="right" target="right"/>
      <line own="top" target="top"/>
      <line own="bottom" target="bottom"/>
    </anchors>
  </gz-gui>

  <state>/cite/cell_b/console/state</state>
  <start_robot>/cite/cell_b/console/start_robot</start_robot>
  <confirm_operator>/cite/cell_b/console/confirm_operator</confirm_operator>
  <stop>/cite/cell_b/console/stop</stop>
  <home>/cite/cell_b/console/home</home>
  <run_program>/cite/cell_b/console/run_program</run_program>
  <validate_then_run>/cite/cell_b/console/validate_then_run</validate_then_run>

  <!-- Where the panel's "Reset view" returns the 3D view: the camera_pose
       above, the same text. The panel asks the window's CameraTracking plugin
       for it; it moves no robot. -->
  <home_camera_pose>0.88 1.24756522 1.84284919 0 0.575958653 1.57079633</home_camera_pose>

  <!-- The panel's other views (generate/gui.py `camera_presets`), each framed
       from where L0 places this zone's assets, and the rendering node its
       "Follow robot" asks CameraTracking to follow (`follow_target`): the link
       that rides the arm's track, scoped by the arm's model name, since the
       model's own root is welded to the world, and the words the panel names
       that node with (`follow_label`). They move the 3D view only. -->
  <top_camera_pose>0.88 2.95569899 2.78968321 0 1.55334303 1.57079633</top_camera_pose>
  <side_camera_pose>2.96 2.992 1.26733432 0 0.261799388 3.14159265</side_camera_pose>
  <front_camera_pose>0.88 0.982874281 1.24834361 0 0.261799388 1.57079633</front_camera_pose>
  <follow_target>picker::picker_track_carriage</follow_target>
  <follow_label>picker carriage</follow_label>

  <!-- What the panel shows of each side's connection: the sides this pair
       runs, and how long the twin boundary's heartbeat may go unheard before
       the panel shows it as stale (a physical side's deadman timeout, where
       there is one). A display, never a safety function. -->
  <twin_sides>plant counterpart</twin_sides>
  <heartbeat_stale_after_s>0.5</heartbeat_stale_after_s>

  <!-- What the panel's header names and shows (ADR-0074): the facility and the
       zone, the gz-transport topic the world publishes its statistics on
       (sim time, RTF), the world being named for the zone, and how long the
       header shows them as current with none heard. Display only. -->
  <facility_label>CITE</facility_label>
  <zone_label>Cell B</zone_label>
  <world_stats_topic>/world/cell_b/stats</world_stats_topic>
  <world_stats_stale_after_s>1</world_stats_stale_after_s>
</plugin>
