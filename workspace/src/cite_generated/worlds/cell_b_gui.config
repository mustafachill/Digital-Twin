</plugin>

<!-- The operator console's panel (ADR-0071 decision 5): `CellConsole`, from
     cite_console_gui, which puts its own library on GZ_GUI_PLUGIN_PATH. Only on
     the plant's window of a paired zone (generate/gui.py). It holds no logic: it
     shows the console's latched state and sends requests, and every refusal is
     the console's. Each element below is one name the console serves, by the
     key the plan's `console:` block states it under. Anchored over the scene's
     top-right corner, and without a title bar, so that it carries no close
     button that would take the Stop button away with it. -->
<plugin filename="CellConsole" name="Cell console">
  <gz-gui>
    <title>Cell console</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="bool" key="resizable">false</property>
    <property type="double" key="width">380</property>
    <property type="double" key="height">640</property>
    <property type="double" key="z">2</property>
    <property type="string" key="state">floating</property>
    <anchors target="3D View">
      <line own="right" target="right"/>
      <line own="top" target="top"/>
    </anchors>
  </gz-gui>

  <state>/cite/cell_b/console/state</state>
  <start_robot>/cite/cell_b/console/start_robot</start_robot>
  <confirm_operator>/cite/cell_b/console/confirm_operator</confirm_operator>
  <stop>/cite/cell_b/console/stop</stop>
  <home>/cite/cell_b/console/home</home>
  <run_program>/cite/cell_b/console/run_program</run_program>
  <validate_then_run>/cite/cell_b/console/validate_then_run</validate_then_run>

  <!-- Where the panel's "Reset view" returns the 3D view: the camera_pose
       above, the same text. The panel asks the window's CameraTracking plugin
       for it; it moves no robot. -->
  <home_camera_pose>0.88 1.24756522 1.84284919 0 0.575958653 1.57079633</home_camera_pose>

  <!-- The panel's other views (generate/gui.py `camera_presets`), each framed
       from where L0 places this zone's assets, and the rendering node its
       "Follow robot" asks CameraTracking to follow (`follow_target`): the link
       that rides the arm's track, scoped by the arm's model name, since the
       model's own root is welded to the world. They move the 3D view only. -->
  <top_camera_pose>0.88 2.95569899 2.78968321 0 1.55334303 1.57079633</top_camera_pose>
  <side_camera_pose>2.96 2.992 1.26733432 0 0.261799388 3.14159265</side_camera_pose>
  <front_camera_pose>0.88 0.982874281 1.24834361 0 0.261799388 1.57079633</front_camera_pose>
  <follow_target>picker::picker_track_carriage</follow_target>

  <!-- What the panel shows of each side's connection: the sides this pair
       runs, and how long the twin boundary's heartbeat may go unheard before
       the panel shows it as stale (a physical side's deadman timeout, where
       there is one). A display, never a safety function. -->
  <twin_sides>plant counterpart</twin_sides>
  <heartbeat_stale_after_s>0.5</heartbeat_stale_after_s>
</plugin>
