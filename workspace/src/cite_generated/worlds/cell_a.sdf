         beam_pose is where the HOUSING stands. beam_offset_m is how far past it,
         along the beam axis, the middle of the beam lies — because a through
         beam is emitted from its housing and crosses what it watches, rather
         than being centred on it. -->
    <plugin filename="cite_break_beam" name="cite_simulation::BreakBeam">
      <beam_pose>5.75 0.25 0.63 0 0 0</beam_pose>
      <beam_axis>y</beam_axis>
      <beam_length_m>0.5</beam_length_m>
      <beam_width_m>0.04</beam_width_m>
      <beam_offset_m>-0.25</beam_offset_m>
      <state_topic>/cite/cell_a/beam_c3_out/detection</state_topic>
      <publish_period_s>0.1</publish_period_s>
      <watch>workpiece</watch>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
