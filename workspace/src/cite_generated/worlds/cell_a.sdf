<?xml version="1.0"?>
<!-- GENERATED by cite-model. DO NOT EDIT.
     Source:     model/
     Regenerate: ./scripts/validate-model, passing the write flag.
     A hand edit here is a Critical review finding (ADR-0004) and is detected by
     ./scripts/validate-model, which diffs this tree against a fresh generator run. -->
<sdf version="1.9">
  <world name="cell_a">
    <physics name="default" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Contact reporting. Kept deliberately, though nothing in this repository
         reads it today: it was loaded for ADR-0023's attachment plugin, which is
         removed, and it is what any `<sensor type="contact">` a scenario declares
         would need. It is a generic simulator capability rather than plugin
         apparatus, so it is left in place rather than removed and rediscovered. -->
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <!-- conveyor_1 — a belt, as a simulation fidelity aid.

         A world system rather than a model plugin, because converting the scene
         from URDF to SDF lumps every fixed-jointed body into one link: there is
         no conveyor_1 model in the spawned world to attach to. Every
         value below is resolved from L0, including the pose, which comes from
         the same surface frame the stations pick and place against.

         Nothing above ros2_control knows this exists. It speaks Gazebo transport
         only; naming and typing it for ROS is a bridge's business, above this
         boundary and identical on the hardware path. -->
    <plugin filename="cite_conveyor" name="cite_simulation::Conveyor">
      <surface_pose>1.05 0 0.6 0 0 0</surface_pose>
      <belt_length_m>1.2</belt_length_m>
      <belt_width_m>0.4</belt_width_m>
      <carry_height_m>0.1</carry_height_m>
      <direction>forward</direction>
      <installed_speed_mps>0.15</installed_speed_mps>
      <command_topic>/cite/cell_a/conveyor_1/command</command_topic>
      <state_topic>/cite/cell_a/conveyor_1/state</state_topic>
      <publish_period_s>0.1</publish_period_s>
      <carry>workpiece</carry>
    </plugin>

    <!-- conveyor_2 — a belt, as a simulation fidelity aid.

         A world system rather than a model plugin, because converting the scene
         from URDF to SDF lumps every fixed-jointed body into one link: there is
         no conveyor_2 model in the spawned world to attach to. Every
