<?xml version="1.0"?>
<!-- GENERATED by cite-model. DO NOT EDIT.
     Source:     model/
     Regenerate: ./scripts/validate-model, passing the write flag.
     A hand edit here is a Critical review finding (ADR-0004) and is detected by
     ./scripts/validate-model, which diffs this tree against a fresh generator run. -->
<sdf version="1.9">
  <world name="cell_b">
    <physics name="default" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Contact reporting. Kept deliberately, though nothing in this repository
         reads it today: it was loaded for ADR-0023's attachment plugin, which is
         removed, and it is what any `<sensor type="contact">` a scenario declares
         would need. It is a generic simulator capability rather than plugin
         apparatus, so it is left in place rather than removed and rediscovered. -->
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <!-- transfer_belt — a belt, as a simulation fidelity aid.

         A world system rather than a model plugin, because converting the scene
         from URDF to SDF lumps every fixed-jointed body into one link: there is
         no transfer_belt model in the spawned world to attach to. Every
         value below is resolved from L0, including the pose, which comes from
         the same surface frame the stations pick and place against.

         Nothing above ros2_control knows this exists. It speaks Gazebo transport
         only; naming and typing it for ROS is a bridge's business, above this
         boundary and identical on the hardware path. -->
    <plugin filename="cite_conveyor" name="cite_simulation::Conveyor">
      <surface_pose>1.05 3 0.6 0 0 0</surface_pose>
      <belt_length_m>1.2</belt_length_m>
      <belt_width_m>0.4</belt_width_m>
      <carry_height_m>0.05</carry_height_m>
      <direction>forward</direction>
      <installed_speed_mps>0.15</installed_speed_mps>
      <command_topic>/cite/cell_b/transfer_belt/command</command_topic>
      <state_topic>/cite/cell_b/transfer_belt/state</state_topic>
      <publish_period_s>0.1</publish_period_s>
      <carry>workpiece</carry>
    </plugin>

    <!-- infeed_beam — a through-beam presence sensor.

         A world system for the same reason the belts are: its housing is lumped
         into the scene's single link, so there is no infeed_beam model to
         attach to and its pose has to arrive as data. It is resolved from the
         same L0 placement that positions the housing, so the beam and the thing
         it is drawn as cannot end up in different places.

         beam_pose is where the HOUSING stands. beam_offset_m is how far past it,
         along the beam axis, the middle of the beam lies — because a through
         beam is emitted from its housing and crosses what it watches, rather
         than being centred on it. -->
    <plugin filename="cite_break_beam" name="cite_simulation::BreakBeam">
      <beam_pose>-0.475 3.25 0.63 0 0 0</beam_pose>
      <beam_axis>y</beam_axis>
      <beam_length_m>0.5</beam_length_m>
      <beam_width_m>0.004</beam_width_m>
      <beam_offset_m>-0.25</beam_offset_m>
      <state_topic>/cite/cell_b/infeed_beam/detection</state_topic>
      <publish_period_s>0.1</publish_period_s>
      <watch>workpiece</watch>
    </plugin>

    <!-- outfeed_beam — a through-beam presence sensor.

         A world system for the same reason the belts are: its housing is lumped
         into the scene's single link, so there is no outfeed_beam model to
         attach to and its pose has to arrive as data. It is resolved from the
         same L0 placement that positions the housing, so the beam and the thing
         it is drawn as cannot end up in different places.

         beam_pose is where the HOUSING stands. beam_offset_m is how far past it,
         along the beam axis, the middle of the beam lies — because a through
         beam is emitted from its housing and crosses what it watches, rather
         than being centred on it. -->
    <plugin filename="cite_break_beam" name="cite_simulation::BreakBeam">
      <beam_pose>1.55 3.25 0.63 0 0 0</beam_pose>
      <beam_axis>y</beam_axis>
      <beam_length_m>0.5</beam_length_m>
      <beam_width_m>0.004</beam_width_m>
      <beam_offset_m>-0.25</beam_offset_m>
      <state_topic>/cite/cell_b/outfeed_beam/detection</state_topic>
      <publish_period_s>0.1</publish_period_s>
      <watch>workpiece</watch>
    </plugin>

    <!-- picker — rigid grasp hold (ADR-0061), told what to hold by the
         cell (ADR-0065).

         A world system for the reason the module docstring gives, not the one
         the belt and the beam have: it reaches across two independently
         spawned models, the arm and the work-piece, exactly as they do.

         MECHANISM. The arm's L3 skill server publishes what it holds, on
         `/cite/cell_b/picker/state`; a simulation-only bridge in
         `cite_bringup` turns each change of that fact into a message here.
         attach_topic takes hold of the nearest declared graspable model within
         attach_radius_m of picker_link5's own origin; detach_topic lets
         go. Both carry the empty message Harmonic's own DetachableJoint takes
         on the same two element names, because this is that system's shape and
         not a protocol invented here.

         WHAT WAS REMOVED, AND WHY IT IS THE DECISION RATHER THAN A TIDY-UP.
         This plugin used to decide for itself that a grasp had begun — the
         drive joint still for the controller's own stall_timeout, resting
         inside the part-width window, a graspable within radius — and that it
         had ended, from a release margin and that same window. Every one of
         those re-derived `cite_skills::gripper_is_holding`, which is the one
         place this project decided what separates a grasp from a stall on
         nothing (ADR-0052). Two thresholds in two packages answering one
         question is what P1 forbids, and tuning them cost two decisions inside
         a week: ADR-0062 clamped the drive joint and was refuted by a paired
         spread of 74.68 mm, ADR-0064 moved the release threshold to the
         window's open end and was refuted by its own promotion condition. The
         cell already knows the answer; it now says so, and this plugin is told.
         Neither record's tables are restated here (P1) — read them.

         WHAT IT KEEPS is the one question the cell cannot answer: WHICH
         declared graspable is in the jaws. That is attach_radius_m and the
         <graspable> list, and it is a fact about the world rather than about
         the gripper. The weld still goes to picker_link5, the arm's own
         last link, and never to a finger — a finger-borne box stops being the
         obstacle the jaws stall against and they close straight through it,
         which is ADR-0023's measured failure (ADR-0061).

         IT NOW SPEAKS GAZEBO TRANSPORT, WHICH IT DELIBERATELY DID NOT. The
         claim that used to stand here — that it neither publishes nor
         subscribes, and reads the ECM alone — is retired, and the cost is
         stated where the property was claimed: a subscription can miss a
         message, where a plugin reading the ECM every step could not. That is
         the trade ADR-0065 takes knowingly, and it is why the state topic this
         chain starts from is latched rather than volatile.

         It still touches no controller and no command interface. The jaws
         close, meet the part, stop at its width and report a stall exactly as
         before; this plugin reads none of that and writes none of it, and the
         drive joint has one owner (ADR-0063). Nothing above ros2_control knows
         it exists, and it is absent from the hardware path, where a real
         gripper needs no help holding what it has clamped. -->
    <plugin filename="cite_grasp_hold" name="cite_simulation::GraspHold">
      <attach_link>picker_link5</attach_link>
      <attach_radius_m>0.2</attach_radius_m>
      <attach_topic>/cite/cell_b/picker/grasp/attach</attach_topic>
      <detach_topic>/cite/cell_b/picker/grasp/detach</detach_topic>
      <graspable>workpiece</graspable>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
