<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypelang="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cite_simulation</name>
  <version>0.1.0</version>
  <description>
    Gazebo Sim system plugins for the CITE cell.

    These are simulation fidelity aids, not control paths. Nothing above
    ros2_control knows they exist, which is what keeps ADR-0005's guarantee
    intact: the same skill code runs against a physical arm, where the physics
    needs no help.
  </description>
  <maintainer email="cite@shsu.edu">CITE Digital Twin</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- No rclcpp and no cite_interfaces. Neither was ever find_package'd or
       linked, and the cite_interfaces entry in particular invited the belief
       that these plugins speak ROS types — which is exactly what the
       description above denies and what ADR-0023 depends on staying false. -->
  <depend>gz_sim_vendor</depend>
  <depend>gz_plugin_vendor</depend>
  <depend>gz_transport_vendor</depend>
  <depend>gz_math_vendor</depend>
  <depend>gz_msgs_vendor</depend>

  <!-- ament_lint_auto discovers linters through the test dependencies declared
       here. With only ament_lint_auto declared it discovers NONE, ctest reports
       "No tests were found!!!" and exits 0, and the lint gate reports a clean
       run having checked nothing. -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
