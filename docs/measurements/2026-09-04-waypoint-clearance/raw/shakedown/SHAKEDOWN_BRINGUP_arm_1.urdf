  <!-- Insert at the end of xarm_device_macro.xacro -->
  <!-- Bolt the arm to the world.

       `create_attach_link` is false and `arm_1_mount` is not the name
       the URDF-to-SDF converter anchors on, so without this the arm's root is a
       free rigid body standing on its pedestal by contact friction alone. Joint
       reaction torques slide or tip it, and the symptom — base drift — reads as
       a calibration fault.

       The joint lives inside a `gazebo` block rather than as a URDF joint to a
       link named `world`, and that placement is the whole point: a URDF `world`
       link would make `robot_state_publisher` publish `world` -> mount as a
       second parent for a frame the generated static transform table already
       parents to `cite_world`. One frame, two parents, intermittently wrong.
       Inside `gazebo` the converter sees it and TF never does.

       The joint carries no pose. Where the arm stands is stated once, by the
       spawn pose in the bring-up plan; a pose here would apply it twice. -->
  <gazebo>
    <joint name="arm_1_mount_world_anchor" type="fixed">
      <parent>world</parent>
      <child>arm_1_mount</child>
    </joint>
  </gazebo>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/workspace/workspace/install/cite_generated/share/cite_generated/control/cell_a_arm_1_controllers.yaml</parameters>
      <ros>
        <namespace>/cite/cell_a/arm_1</namespace>
      </ros>
    </plugin>
  </gazebo>
</robot>

