<?xml version="1.0" ?>
<!--
  Digital Twin Robotics Laboratory Environment
  
  Bu world dosyası xArm 5 robot kolunun çalışacağı laboratuvar ortamını tanımlar.
  Blender'dan export edilen modeller models/ klasörüne eklendikçe buraya include edilecek.
  
  Kullanım:
    ros2 launch digital_twin_environment lab_with_xarm5.launch.py
-->
<sdf version="1.6">
  <world name="robotics_lab">
    
    <!-- ============================================== -->
    <!-- LIGHTING - Işıklandırma                        -->
    <!-- ============================================== -->
    
    <!-- Ana güneş ışığı -->
    <include>
      <uri>model://sun</uri>
    </include>
    
    <!-- Ek spot ışık (lab ortamı için) -->
    <light name="lab_light_1" type="point">
      <pose>0 0 3 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <cast_shadows>true</cast_shadows>
    </light>
    
    <!-- ============================================== -->
    <!-- GROUND - Zemin                                 -->
    <!-- ============================================== -->
    
    <!-- Varsayılan zemin (Blender modeli eklenince değiştirilecek) -->
    <include>
      <uri>model://ground_plane</uri>
    </include>
    
    <!-- TODO: Blender lab_floor modeli eklenince:
    <include>
      <uri>model://lab_floor</uri>
      <name>laboratory_floor</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
    -->
    
    <!-- ============================================== -->
    <!-- WORKBENCH - Çalışma Masası (xArm 5 monte)      -->
    <!-- ============================================== -->
    
    <!-- Varsayılan masa (Gazebo default table) -->
    <include>
      <uri>model://table</uri>
      <name>xarm_workbench</name>
      <pose>0.0 -0.84 0 0 0 0</pose>
    </include>
    
    <!-- TODO: Blender workbench modeli eklenince:
    <include>
      <uri>model://workbench</uri>
      <name>xarm_workbench</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
    -->
    
    <!-- ============================================== -->
    <!-- LABORATORY EQUIPMENT - Lab Ekipmanları         -->
    <!-- ============================================== -->
    
    <!-- 
    Aşağıdaki bölüme Blender'dan export edilen modeller eklenecek.
    Her model için:
    1. models/ klasörüne model klasörü oluştur
    2. model.config ve model.sdf dosyalarını ekle
    3. meshes/ içine .dae dosyasını koy
    4. Buraya <include> bloğu ekle
    
    Örnek:
    <include>
      <uri>model://shelf</uri>
      <name>equipment_shelf</name>
      <pose>2 0 0 0 0 0</pose>
    </include>
    
    <include>
      <uri>model://tool_cabinet</uri>
      <name>tool_cabinet_1</name>
      <pose>-2 1 0 0 0 1.57</pose>
    </include>
    -->
    
    <!-- ============================================== -->
    <!-- WALLS - Duvarlar (Opsiyonel)                   -->
    <!-- ============================================== -->
    
    <!--
    Lab duvarları eklemek için:
    <include>
      <uri>model://lab_wall</uri>
      <name>wall_north</name>
      <pose>0 5 0 0 0 0</pose>
    </include>
    -->
    
    <!-- ============================================== -->
    <!-- PHYSICS - Fizik Ayarları                       -->
    <!-- ============================================== -->
    
    <physics type="ode">
      <!-- Simülasyon adım boyutu (saniye) -->
      <max_step_size>0.001</max_step_size>
      
      <!-- Gerçek zamanlı oran (1.0 = gerçek zaman) -->
      <real_time_factor>1</real_time_factor>
      
      <!-- Güncelleme hızı (Hz) -->
      <real_time_update_rate>1000</real_time_update_rate>
      
      <!-- Yerçekimi (m/s²) -->
      <!-- Not: xArm simülasyonu gravity=0 kullanıyor, gerekirse değiştir -->
      <gravity>0 0 0</gravity>
    </physics>
    
    <!-- ============================================== -->
    <!-- SCENE - Sahne Ayarları                         -->
    <!-- ============================================== -->
    
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    
    <!-- ============================================== -->
    <!-- GUI - Kamera Başlangıç Pozisyonu               -->
    <!-- ============================================== -->
    
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>3.0 -3.0 2.5 0 0.5 2.35</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
    
  </world>
</sdf>

