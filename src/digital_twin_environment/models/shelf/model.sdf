<?xml version="1.0"?>
<!--
  Shelf Model - Raf/Dolap
  
  Dosya: meshes/shelf.dae
-->
<sdf version="1.6">
  <model name="shelf">
    <static>true</static>
    
    <link name="shelf_link">
      <visual name="shelf_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://shelf/meshes/shelf.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.4 0.3 0.2 1</ambient>
          <diffuse>0.6 0.5 0.4 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      
      <collision name="shelf_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://shelf/meshes/shelf.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>

