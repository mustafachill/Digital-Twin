<?xml version="1.0"?>
<!--
  Lab Floor Model - Laboratuvar Zemini
  
  Bu dosya Blender'dan export edilen mesh'i Gazebo'da kullanılabilir hale getirir.
  
  Dosya: meshes/lab_floor.dae
-->
<sdf version="1.6">
  <model name="lab_floor">
    <static>true</static>
    
    <link name="floor_link">
      <!-- Görsel (Visual) -->
      <visual name="floor_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://lab_floor/meshes/lab_floor.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      
      <!-- Çarpışma (Collision) -->
      <collision name="floor_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://lab_floor/meshes/lab_floor.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>

