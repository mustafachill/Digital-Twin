<?xml version="1.0"?>
<!--
  Workbench Model - xArm 5 Çalışma Masası
  
  Bu dosya Blender'dan export edilen mesh'i Gazebo'da kullanılabilir hale getirir.
  
  Blender Export Ayarları:
  - Format: COLLADA (.dae)
  - Scale: 1.0 (Blender'da 1 unit = 1 metre olmalı)
  - Apply Modifiers: Enabled
  - Include: Mesh only (armature yok)
  
  Dosya: meshes/workbench.dae
-->
<sdf version="1.6">
  <model name="workbench">
    <static>true</static>
    
    <link name="workbench_link">
      <!-- Görsel (Visual) -->
      <visual name="workbench_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://workbench/meshes/workbench.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <!-- Material (Blender texture varsa otomatik yüklenir) -->
        <material>
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      
      <!-- Çarpışma (Collision) - Basitleştirilmiş geometri -->
      <collision name="workbench_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <!-- Seçenek 1: Aynı mesh kullan (daha doğru, daha yavaş) -->
          <mesh>
            <uri>model://workbench/meshes/workbench.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
          
          <!-- Seçenek 2: Basit kutu kullan (daha hızlı, yaklaşık)
          <box>
            <size>1.2 0.8 0.75</size>
          </box>
          -->
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>1</kd>
            </ode>
          </contact>
        </surface>
      </collision>
      
      <!-- Atalet (Inertial) - Statik modeller için opsiyonel -->
      <!--
      <inertial>
        <mass>50.0</mass>
        <inertia>
          <ixx>5.0</ixx>
          <iyy>5.0</iyy>
          <izz>5.0</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      -->
    </link>
  </model>
</sdf>

