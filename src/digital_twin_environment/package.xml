<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>digital_twin_environment</name>
  <version>1.0.0</version>
  <description>
    Gazebo environment package for Digital Twin robotics laboratory simulation.
    Contains world files, custom models, and materials for simulating the real robot workspace.
  </description>
  <maintainer email="mustafacil@example.com">Mustafa Cil</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>xarm_gazebo</exec_depend>
  <exec_depend>xarm_moveit_config</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/models"/>
  </export>
</package>

