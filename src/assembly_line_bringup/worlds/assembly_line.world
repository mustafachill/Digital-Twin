<?xml version="1.0" ?>
<!--
  Assembly Line World - 3 Parallel Conveyors
  Multi-robot serial transfer simulation environment
  
  Components:
  - 3 parallel conveyor belts (2m each) with ROS2 plugin
  - Pick area (Robot 1 source)
  - Accumulation area (Belt 3 end)
  - Belt-end sensors for Robot 2 and Robot 3
  - Lighting and ground plane
-->
<sdf version="1.6">
  <world name="assembly_line">
    
    <!-- Physics configuration -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <gravity>0 0 -9.81</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
        </constraints>
      </ode>
    </physics>
    
    <!-- Lighting -->
    <include>
      <uri>model://sun</uri>
    </include>
    
    <!-- Additional ceiling lights -->
    <light name="ceiling_light_1" type="point">
      <pose>-2 0 3 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>
    
    <light name="ceiling_light_2" type="point">
      <pose>0 0 3 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>
    
    <light name="ceiling_light_3" type="point">
      <pose>2 0 3 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>
    
    <!-- Ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>
    
    <!-- ============================================ -->
    <!-- CONVEYOR BELT 1 (Robot 1 -> Robot 2)       -->
    <!-- Belt at X=-1.5, runs along Y-axis (2m)     -->
    <!-- ============================================ -->
    <include>
      <uri>model://conveyor_belt_1</uri>
      <pose>-1.5 0.0 0 0 0 0</pose>
    </include>
    
    <!-- ============================================ -->
    <!-- CONVEYOR BELT 2 (Robot 2 -> Robot 3)       -->
    <!-- Belt at X=0.0, runs along Y-axis (2m)      -->
    <!-- ============================================ -->
    <include>
      <uri>model://conveyor_belt_2</uri>
      <pose>0.0 0.0 0 0 0 0</pose>
    </include>
    
    <!-- ============================================ -->
    <!-- CONVEYOR BELT 3 (Robot 3 -> Accumulation)  -->
    <!-- Belt at X=1.5, runs along Y-axis (2m)      -->
    <!-- ============================================ -->
    <include>
      <uri>model://conveyor_belt_3</uri>
      <pose>1.5 0.0 0 0 0 0</pose>
    </include>
    
    <!-- ============================================ -->
    <!-- PICK AREA (Source for Robot 1)             -->
    <!-- West of Robot 1 (x=-2.8, y=-0.5)           -->
    <!-- ============================================ -->
    <model name="pick_area_table">
      <static>true</static>
      <pose>-2.8 -0.5 0 0 0 0</pose>
      <link name="table_link">
        <visual name="tabletop">
          <pose>0 0 0.78 0 0 0</pose>
          <geometry>
            <box><size>0.6 0.6 0.04</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.6 0.2 1</ambient>
            <diffuse>0.3 0.7 0.3 1</diffuse>
          </material>
        </visual>
        <collision name="tabletop_collision">
          <pose>0 0 0.78 0 0 0</pose>
          <geometry>
            <box><size>0.6 0.6 0.04</size></box>
          </geometry>
        </collision>
        <!-- Legs -->
        <visual name="leg1">
          <pose>0.25 0.25 0.38 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.76</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material>
        </visual>
        <visual name="leg2">
          <pose>-0.25 0.25 0.38 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.76</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material>
        </visual>
        <visual name="leg3">
          <pose>0.25 -0.25 0.38 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.76</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material>
        </visual>
        <visual name="leg4">
          <pose>-0.25 -0.25 0.38 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.76</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material>
        </visual>
      </link>
    </model>
    
    <!-- ============================================ -->
    <!-- ACCUMULATION AREA (End of Belt 3)         -->
    <!-- North end of Belt 3 (x=1.5, y=1.2)         -->
    <!-- ============================================ -->
    <model name="accumulation_area_table">
      <static>true</static>
      <pose>1.5 1.2 0 0 0 0</pose>
      <link name="table_link">
        <visual name="tabletop">
          <pose>0 0 0.78 0 0 0</pose>
          <geometry>
            <box><size>0.8 0.8 0.04</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.2 0.2 1</ambient>
            <diffuse>0.7 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <collision name="tabletop_collision">
          <pose>0 0 0.78 0 0 0</pose>
          <geometry>
            <box><size>0.8 0.8 0.04</size></box>
          </geometry>
        </collision>
        <!-- Legs -->
        <visual name="leg1">
          <pose>0.35 0.35 0.38 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.76</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material>
        </visual>
        <visual name="leg2">
          <pose>-0.35 0.35 0.38 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.76</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material>
        </visual>
        <visual name="leg3">
          <pose>0.35 -0.35 0.38 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.76</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material>
        </visual>
        <visual name="leg4">
          <pose>-0.35 -0.35 0.38 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.76</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material>
        </visual>
      </link>
    </model>
    
    <!-- ============================================ -->
    <!-- BELT END SENSORS                           -->
    <!-- ============================================ -->
    
    <!-- Belt 1 End Sensor (triggers Robot 2) -->
    <!-- At north end of Belt 1 (x=-1.5, y=0.9), before R2 -->
    <model name="belt_1_end_sensor">
      <static>true</static>
      <pose>-1.5 0.9 0.85 0 0 1.5708</pose>
      <link name="sensor_link">
        <!-- Emitter side -->
        <visual name="emitter">
          <pose>-0.24 0 0 0 0 0</pose>
          <geometry><box><size>0.02 0.02 0.05</size></box></geometry>
          <material><ambient>0.1 0.8 0.1 1</ambient></material>
        </visual>
        <!-- Receiver side -->
        <visual name="receiver">
          <pose>0.24 0 0 0 0 0</pose>
          <geometry><box><size>0.02 0.02 0.05</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient></material>
        </visual>
        <!-- Ray sensor -->
        <sensor name="break_beam_sensor" type="ray">
          <pose>-0.22 0 0 0 0 0</pose>
          <ray>
            <scan>
              <horizontal>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.01</min>
              <max>0.5</max>
              <resolution>0.001</resolution>
            </range>
          </ray>
          <plugin name="gazebo_ros_ray_sensor" filename="libgazebo_ros_ray_sensor.so">
            <ros>
              <namespace>sensors/belt_1_end</namespace>
              <remapping>~/out:=break_beam</remapping>
            </ros>
            <output_type>sensor_msgs/Range</output_type>
            <frame_name>belt_1_end_sensor</frame_name>
          </plugin>
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
        </sensor>
      </link>
    </model>
    
    <!-- Belt 2 End Sensor (triggers Robot 3) -->
    <!-- At south end of Belt 2 (x=0.0, y=-0.9), before R3 (Belt 2 flows south!) -->
    <model name="belt_2_end_sensor">
      <static>true</static>
      <pose>0.0 -0.9 0.85 0 0 1.5708</pose>
      <link name="sensor_link">
        <visual name="emitter">
          <pose>-0.24 0 0 0 0 0</pose>
          <geometry><box><size>0.02 0.02 0.05</size></box></geometry>
          <material><ambient>0.1 0.8 0.1 1</ambient></material>
        </visual>
        <visual name="receiver">
          <pose>0.24 0 0 0 0 0</pose>
          <geometry><box><size>0.02 0.02 0.05</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient></material>
        </visual>
        <sensor name="break_beam_sensor" type="ray">
          <pose>-0.22 0 0 0 0 0</pose>
          <ray>
            <scan>
              <horizontal>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.01</min>
              <max>0.5</max>
              <resolution>0.001</resolution>
            </range>
          </ray>
          <plugin name="gazebo_ros_ray_sensor" filename="libgazebo_ros_ray_sensor.so">
            <ros>
              <namespace>sensors/belt_2_end</namespace>
              <remapping>~/out:=break_beam</remapping>
            </ros>
            <output_type>sensor_msgs/Range</output_type>
            <frame_name>belt_2_end_sensor</frame_name>
          </plugin>
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
        </sensor>
      </link>
    </model>
    
    <!-- ============================================ -->
    <!-- TEST PAYLOAD BOX (on pick area)            -->
    <!-- Starts on pick_area_table for Robot 1     -->
    <!-- ============================================ -->
    <model name="payload_box_1">
      <static>false</static>
      <pose>-2.8 -0.5 0.85 0 0 0</pose>
      <link name="box_link">
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.000833</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.000833</iyy><iyz>0</iyz><izz>0.000833</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
          <material><ambient>0.8 0.2 0.1 1</ambient></material>
        </visual>
      </link>
    </model>
    
    <!-- Scene settings -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

  </world>
</sdf>
