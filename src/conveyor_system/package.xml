<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>conveyor_system</name>
  <version>1.0.0</version>
  <description>
    Conveyor system models and configuration for the assembly line simulation.
    Includes conveyor belt variations and payload box models.
  </description>

  <author email="mustafacil@example.com">Mustafa Cil</author>
  <maintainer email="mustafacil@example.com">Mustafa Cil</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gazebo_ros</depend>
  <depend>conveyorbelt_msgs</depend>
  <depend>ros2_conveyorbelt</depend>
  <depend>conveyorbelt_gazebo</depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>gazebo_ros_pkgs</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/models"/>
  </export>
</package>

