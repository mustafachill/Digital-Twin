<?xml version="1.0" ?>
<!--
  Break Beam Sensor for Assembly Line
  Detects objects passing through the beam using a ray sensor.
-->
<sdf version="1.6">
  <model name="break_beam_sensor">
    <static>true</static>
    
    <!-- Emitter side -->
    <link name="emitter_link">
      <pose>-0.25 0 0.1 0 0 0</pose>
      
      <visual name="emitter_visual">
        <geometry>
          <box>
            <size>0.02 0.02 0.2</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.8 1</ambient>
          <diffuse>0.2 0.2 0.9 1</diffuse>
        </material>
      </visual>
      
      <collision name="emitter_collision">
        <geometry>
          <box>
            <size>0.02 0.02 0.2</size>
          </box>
        </geometry>
      </collision>
      
      <!-- Ray sensor for break beam detection -->
      <sensor name="break_beam" type="ray">
        <pose>0.01 0 0.05 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>true</visualize>
        
        <ray>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.01</min>
            <max>0.6</max>
            <resolution>0.001</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.001</stddev>
          </noise>
        </ray>
        
        <plugin name="break_beam_sensor_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>station</namespace>
            <remapping>~/out:=break_beam</remapping>
          </ros>
          <output_type>sensor_msgs/Range</output_type>
          <frame_name>break_beam_frame</frame_name>
        </plugin>
      </sensor>
    </link>
    
    <!-- Receiver side -->
    <link name="receiver_link">
      <pose>0.25 0 0.1 0 0 0</pose>
      
      <visual name="receiver_visual">
        <geometry>
          <box>
            <size>0.02 0.02 0.2</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.1 0.1 1</ambient>
          <diffuse>0.9 0.2 0.2 1</diffuse>
        </material>
      </visual>
      
      <collision name="receiver_collision">
        <geometry>
          <box>
            <size>0.02 0.02 0.2</size>
          </box>
        </geometry>
      </collision>
    </link>
    
    <!-- Base plate -->
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      
      <visual name="base_visual">
        <geometry>
          <box>
            <size>0.6 0.05 0.01</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.4 0.4 0.4 1</diffuse>
        </material>
      </visual>
      
      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.6 0.05 0.01</size>
          </box>
        </geometry>
      </collision>
    </link>
    
    <!-- Joints -->
    <joint name="emitter_joint" type="fixed">
      <parent>base_link</parent>
      <child>emitter_link</child>
    </joint>
    
    <joint name="receiver_joint" type="fixed">
      <parent>base_link</parent>
      <child>receiver_link</child>
    </joint>
    
  </model>
</sdf>

