<?xml version="1.0"?>
<!--
  Sensor Station XACRO
  Combines RealSense D435 camera with break beam and proximity sensors.
  Mount this above each robot station on the assembly line.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Sensor Station Macro -->
  <xacro:macro name="sensor_station" params="station_name parent_link x y z">
    
    <!-- Station mount frame -->
    <link name="${station_name}_mount">
      <visual>
        <geometry>
          <box size="0.1 0.1 0.02"/>
        </geometry>
        <material name="dark_gray">
          <color rgba="0.3 0.3 0.3 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.1 0.1 0.02"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
    
    <joint name="${station_name}_mount_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${station_name}_mount"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
    </joint>
    
    <!-- Camera mount arm -->
    <link name="${station_name}_camera_arm">
      <visual>
        <origin xyz="0 0 0.15" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.01" length="0.3"/>
        </geometry>
        <material name="aluminum">
          <color rgba="0.7 0.7 0.7 1"/>
        </material>
      </visual>
    </link>
    
    <joint name="${station_name}_camera_arm_joint" type="fixed">
      <parent link="${station_name}_mount"/>
      <child link="${station_name}_camera_arm"/>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
    </joint>
    
    <!-- RealSense D435 Camera Frame -->
    <link name="${station_name}_camera_link">
      <visual>
        <geometry>
          <box size="0.09 0.025 0.025"/>
        </geometry>
        <material name="camera_gray">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.09 0.025 0.025"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>
    
    <joint name="${station_name}_camera_joint" type="fixed">
      <parent link="${station_name}_camera_arm"/>
      <child link="${station_name}_camera_link"/>
      <!-- Camera points down at 45 degrees -->
      <origin xyz="0 0 0.31" rpy="0 0.785 0"/>
    </joint>
    
    <!-- Camera optical frames -->
    <link name="${station_name}_color_optical_frame"/>
    <joint name="${station_name}_color_optical_joint" type="fixed">
      <parent link="${station_name}_camera_link"/>
      <child link="${station_name}_color_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    </joint>
    
    <link name="${station_name}_depth_optical_frame"/>
    <joint name="${station_name}_depth_optical_joint" type="fixed">
      <parent link="${station_name}_camera_link"/>
      <child link="${station_name}_depth_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    </joint>
    
    <!-- RealSense D435 Gazebo Plugin -->
    <gazebo reference="${station_name}_camera_link">
      <!-- Color camera -->
      <sensor name="${station_name}_color" type="camera">
        <camera name="camera">
          <horizontal_fov>1.21</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>RGB_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        
        <plugin name="${station_name}_camera_controller" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>${station_name}</namespace>
            <remapping>image_raw:=camera/color/image_raw</remapping>
            <remapping>camera_info:=camera/color/camera_info</remapping>
          </ros>
          <camera_name>${station_name}_color</camera_name>
          <frame_name>${station_name}_color_optical_frame</frame_name>
        </plugin>
      </sensor>
      
      <!-- Depth camera -->
      <sensor name="${station_name}_depth" type="depth">
        <camera name="camera">
          <horizontal_fov>1.21</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>10</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        
        <plugin name="${station_name}_depth_controller" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>${station_name}</namespace>
            <remapping>image_raw:=camera/depth/image_raw</remapping>
            <remapping>camera_info:=camera/depth/camera_info</remapping>
            <remapping>points:=camera/depth/points</remapping>
          </ros>
          <camera_name>${station_name}_depth</camera_name>
          <frame_name>${station_name}_depth_optical_frame</frame_name>
          <min_depth>0.1</min_depth>
          <max_depth>10.0</max_depth>
        </plugin>
      </sensor>
    </gazebo>
    
  </xacro:macro>

</robot>

