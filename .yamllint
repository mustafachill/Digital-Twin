---
# YAML conventions for this repository.
# Relaxed where the default is stylistic; strict where a mistake would matter —
# the facility model and the dependency manifest are read by tooling, and a
# duplicate key or a truthy ambiguity there is a real defect.

extends: default

rules:
  line-length:
    max: 120
    allow-non-breakable-words: true
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  document-start:
    present: true
  truthy:
    # GitHub Actions uses `on:` as a key, which the default rule flags.
    allowed-values: ['true', 'false']
    check-keys: false
  indentation:
    spaces: consistent
    indent-sequences: consistent

ignore: |
  legacy/
  .venv/
  workspace/
