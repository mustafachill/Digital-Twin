<?xml version="1.0"?>
<!-- GENERATED by cite-model. DO NOT EDIT.
     Source:     model/
     Regenerate: ./scripts/validate-model, passing the write flag.
     A hand edit here is a Critical review finding (ADR-0004) and is detected by
     ./scripts/validate-model, which diffs this tree against a fresh generator run. -->
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="cell_b">

  <!-- Anchor the cell furniture to the world.

       Every link below is joined by a fixed joint, so converting this URDF to
       SDF lumps the whole cell into ONE link. Without this the simulator gets a
       single free rigid body of a few hundred kilograms resting on the ground
       plane by contact friction alone: joint reaction torques from the arms
       standing on it slide it, and the symptom is base drift that reads as a
       calibration fault and gets debugged in the wrong layer.

       `static` rather than a fixed joint to a link named `world`: nothing here
       has a joint that moves, and a `world` link would also become a second TF
       parent for every body — `robot_state_publisher` would publish it
       alongside the generated static transform table, giving one frame two
       parents. Static costs the physics engine nothing and changes no name. -->
  <gazebo>
    <static>true</static>
  </gazebo>

  <!-- The facility root. Tied to the surveyed physical origin (L5); every frame
       below is expressed relative to it. -->
  <link name="cite_world"/>

  <!-- The appearances the bodies below wear, defined once each and referenced by
       name. Every value is resolved from the facility's material library in L0;
       nothing here is authored.

       WHY THESE EXIST AT ALL. Until 2026-09-28 every visual in this file was a
       bare <geometry> and the cell rendered black, while L0 had carried a
       material name on each of those bodies the whole time and nothing resolved
       it.

       DEFINED HERE AND REFERENCED BELOW, rather than repeated inside each
       <visual>. urdfdom resolves a name-only <material> against the robot-scope
       map, so this is the form in which one colour is written once per document
       — and repeating a definition makes urdfdom warn that the material is not
       unique and keep whichever it saw first.

       ONE COLOUR, WHERE L0 DECLARES TWO, AND THE DIFFUSE IS THE ONE THAT SURVIVES.
       URDF has a single <color> per material and no ambient term. Measured in
       this project's container on 2026-09-28 with `gz sdf -p` over a probe URDF:
       sdformat copies this rgba onto BOTH the SDF ambient and the SDF diffuse,
       after multiplying the three colour components by 1.25 and clamping each at
       1.0, with alpha untouched. So the declared ambient reaches nothing on this
       path and the declared diffuse is shown 25% brighter.

       That is recorded and NOT compensated for. Dividing by 1.25 here would put
       an undeclared constant in this template that tracks an upstream
       implementation detail, and what it would buy is cosmetic — nothing in this
       repository measures a colour. What the library does instead is keep every
       component a scene body wears at or under 0.8, where the multiply cannot
       clip; the reason is stated on the library itself. -->
  <material name="conveyor_frame">
    <color rgba="0.28 0.34 0.42 1"/>
  </material>
  <material name="sensor_housing">
    <color rgba="0.78 0.62 0.1 1"/>
  </material>
  <material name="table_top">
    <color rgba="0.58 0.38 0.2 1"/>
  </material>

  <!-- infeed_beam — break_beam -->
  <link name="infeed_beam_base_link">
    <inertial>
      <!-- The body's pose names the point it stands on, so the mass sits half a
           height above the link origin. `com_m` is measured from the box centre
           and the tensor beside it is centroidal; declaring both at the foot
           states a centroidal tensor about a point up to 0.3 m from the mass. -->
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.00033333" ixy="0"
               ixz="0" iyy="0.00033333"
               iyz="0" izz="6.667e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.12"/></geometry>
      <material name="sensor_housing"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.12"/></geometry>
    </collision>
  </link>
  <joint name="infeed_beam_anchor" type="fixed">
    <parent link="cite_world"/>
    <child link="infeed_beam_base_link"/>
    <origin xyz="-0.5 2.674 0.63" rpy="0 0 0"/>
  </joint>
  <link name="infeed_beam_beam"/>
