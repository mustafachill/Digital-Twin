# =============================================================================
# External source dependencies — vcstool manifest
#
# Imported into workspace/src/external/ by ./scripts/bootstrap.
#
# RULES (enforced by the dependency-auditor agent, CLAUDE.md §4):
#   1. Never copy third-party source into this repository. Declare it here.
#   2. Pin `version` to an exact commit SHA, never a branch. A branch means two
#      clones on different days produce different code, and reproducibility is
#      gone without anyone noticing.
#   3. Local modifications live in external/patches/ as reviewable patch files
#      applied by bootstrap — never as edits inside a checked-out dependency.
#
# The previous iteration of this project was made unbuildable by breaking rules
# 1 and 3 at once. See legacy/README.md.
# =============================================================================

---
repositories:

  # ---------------------------------------------------------------------------
  # UFACTORY xArm ROS 2 support — robot description, controllers, hardware
  # interface for the physical arms.
  #
  # Gazebo Harmonic support: VERIFIED 2026-08-24.
  #   The `jazzy` branch declares gz_sim_vendor, gz_ros2_control, ros_gz_sim and
  #   ros_gz_bridge in xarm_gazebo/package.xml, with no reference to gazebo_ros,
  #   gazebo_ros2_control or gazebo_dev. It targets Gazebo Sim.
  #   Verified against xarm_gazebo/package.xml on the `jazzy` branch. The branch
  #   README agrees: "Classic Gazebo is no longer supported. Gazebo Harmonic is
  #   supported instead". (The Gazebo Classic link is in the `humble` branch README
  #   — do not read that one and conclude Harmonic is unsupported.) See ADR-0003.
  #
  # PINNED 2026-08-24 — Phase 1.A gate CLOSED.
  #   Verified against our stack before pinning, in the container image, on
  #   arm64:
  #     1. `colcon build` — 12 packages, all succeed.
  #     2. The `xarm_device` macro expands with
  #        ros2_control_plugin:=gz_ros2_control/GazeboSimSystem, add_gripper:=true,
  #        create_attach_link:=false, producing exactly one root link and correctly
  #        prefixed joints (arm_1_joint1..5, arm_1_drive_joint).
  #     3. Spawned into Gazebo Harmonic headless: all six hardware interfaces
  #        present, joint_state_broadcaster + joint_trajectory_controller +
  #        gripper controller configured and activated, a FollowJointTrajectory
  #        goal executed to SUCCEEDED, clean shutdown with no orphans.
  #
  #   Note that `xarm_ros2` carries `xarm_sdk/cxx` as a git submodule. `vcs
  #   import --recursive` in ./scripts/bootstrap is what fetches it; without that
  #   flag the directory arrives empty and the build fails on xarm_sdk.
  #   Reproducibility is still exact, because the submodule pointer is part of
  #   the pinned commit below.
  # ---------------------------------------------------------------------------
  external/xarm_ros2:
    type: git
    url: https://github.com/xArm-Developer/xarm_ros2.git
    version: 3dc2b5e8294758d96b54b15fa5920d581b7cbb3d   # `jazzy` head, 2026-08-11
