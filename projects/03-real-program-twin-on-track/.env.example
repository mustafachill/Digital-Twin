# Environment configuration. Copy to .env — which is gitignored and must never
# be committed, because it will eventually hold robot addresses.
#
#   cp .env.example .env

# --- ROS 2 -------------------------------------------------------------------
# Isolates your nodes from everyone else's on the same network. Pick a value
# nobody else in the lab is using; a collision makes another person's robot
# appear in your graph and is very hard to diagnose.
ROS_DOMAIN_ID=0

# rmw_fastrtps_cpp (default) or rmw_cyclonedds_cpp. All processes that must talk
# to each other need the same value.
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# --- Execution environment ---------------------------------------------------
# auto   use native ROS if present, otherwise the container  (default)
# native never use a container
# docker always use the container
CITE_ENV=auto

# --- Simulation --------------------------------------------------------------
# The seed ./scripts/scenario hands to `gz sim --seed`. It records what a run was
# given; it does NOT make a run reproduce. It reaches gz::math::Rand — sensor
# noise and the comms systems — and not the physics solver and not the planner:
# docs/adr/0027-pilz-planning-pipeline.md. Two runs of one scenario under this
# seed have been measured putting the work-piece in two different places (two
# runs on one machine, not a rate; where that comes from is UNRESOLVED) —
# docs/measurements/2026-09-22-is-a-run-reproducible/. And note that
# ./scripts/sim passes no seed at all, so only a scenario run is seeded.
CITE_PHYSICS_SEED=20260824

# --- Hardware ----------------------------------------------------------------
# Deliberately blank. Filled in at Phase 2, in your local .env only.
# Nothing commands a physical arm unless CITE_ALLOW_HARDWARE=1 is set explicitly.
CITE_ALLOW_HARDWARE=0
# CITE_ROBOT_1_IP=
# CITE_ROBOT_2_IP=
# CITE_ROBOT_3_IP=
