{{ hash_banner() }}
cmake_minimum_required(VERSION 3.16)
project(cite_generated NONE)

find_package(ament_cmake REQUIRED)

install(
  DIRECTORY
{% for directory in directories %}
    {{ directory }}
{% endfor %}
  DESTINATION share/${PROJECT_NAME}
)

install(FILES GENERATED MODEL_HASH DESTINATION share/${PROJECT_NAME})

# Generated does not mean exempt. Without this block ament_lint_auto finds no
# linters, ctest reports "No tests were found!!!" and exits 0, and the lint gate
# reports a clean package having checked nothing — which is exactly the "capability
# marked complete without a test proving it" that CLAUDE.md forbids. What is linted
# here is this file and package.xml: both are generated, so a lint failure is a
# defect in the generator, never something to fix in place (ADR-0021).
if(BUILD_TESTING)
  find_package(ament_lint_auto REQUIRED)
  ament_lint_auto_find_test_dependencies()
endif()

ament_package()
