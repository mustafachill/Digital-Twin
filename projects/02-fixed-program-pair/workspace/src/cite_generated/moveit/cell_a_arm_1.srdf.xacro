<!-- GENERATED by cite-model. DO NOT EDIT.
     Source:     model/
     Regenerate: ./scripts/validate-model, passing the write flag.
     A hand edit here is a Critical review finding (ADR-0004) and is detected by
     ./scripts/validate-model, which diffs this tree against a fresh generator run. -->
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="arm_1">

  <!-- The vendor SRDF macro, invoked with our prefix — never copied. It carries
       the self-collision matrix, which the vendor computed against the vendor's
       own collision geometry; re-deriving it here would mean inventing an answer
       the vendor already has, and getting it wrong is how a planner starts
       refusing valid states or permitting invalid ones.

       READ THIS BEFORE TRUSTING THE MATRIX. Since 2026-09-01 this cell's arms do
       NOT collide against the geometry that matrix was computed against: L0
       selects convex hulls of the vendor meshes (ADR-0028, `Accepted`), and a
       hull is never smaller than what it replaces. So the pairing between the
       matrix and the geometry is broken, deliberately and knowingly, and nothing
       in this repository checks it. ADR-0028's amendment of 2026-09-01 sizes it —
       and records why the interim check that record named was considered and
       declined. -->
  <xacro:include filename="$(find xarm_moveit_config)/srdf/xarm_macro.srdf.xacro"/>
  <xacro:xarm_macro_srdf
      add_gripper="true"
      dof="5"
      prefix="arm_1_"
      robot_type="xarm"
  />
</robot>
