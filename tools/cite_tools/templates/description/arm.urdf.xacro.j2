<?xml version="1.0"?>
{{ xml_banner() }}
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="{{ arm.id }}">

  <!-- One description per arm, spawned as its own Gazebo model.
       gz_ros2_control attaches to a MODEL, and the controller manager it creates
       claims every ros2_control component in that model's description. With a
       zone's arms in one model, every manager claimed every joint in the cell and
       wrote to all of them each cycle. Splitting the arms into separate models
       gives each manager exactly its own hardware — and keeps the namespace
       /cite/<zone>/<asset_id> that the naming scheme requires. -->

  <!-- The root. Placed in the world at spawn time, and tied to cite_world by the
       generated static transform table, so this description states no world
       coordinate of its own. -->
  <link name="{{ arm.mount_link }}"/>
{% if arm.axis %}

  <!-- The linear track this arm rides (ADR-0067). Its rail is a body in the
       scene; its one joint is HERE, between the mount and the carriage the arm's
       base is bolted to, so robot_state_publisher, MoveIt's robot state and its
       collision checks all see where the arm really is. The mount stands where
       the carriage is at stroke zero, and the axis is stated in the mount's own
       frame, derived from the track type's direction.

       The carriage has mass because a massless link between two joints is
       dropped by the URDF-to-SDF converter, and the axis with it. It has no
       collision geometry: the plate rides 5 mm above the rail's top face and is
       drawn, not checked. -->
  <link name="{{ arm.axis.carriage_link }}">
    <inertial>
      <origin xyz="0 0 {{ arm.axis.half_height_m }}" rpy="0 0 0"/>
      <mass value="{{ arm.axis.mass_kg }}"/>
      <inertia ixx="{{ arm.axis.ixx }}" ixy="0" ixz="0" iyy="{{ arm.axis.iyy }}" iyz="0" izz="{{ arm.axis.izz }}"/>
    </inertial>
    <visual>
      <origin xyz="0 0 {{ arm.axis.half_height_m }}" rpy="0 0 0"/>
      <geometry><box size="{{ arm.axis.size_m }}"/></geometry>
    </visual>
  </link>
  <joint name="{{ arm.axis.joint }}" type="prismatic">
    <parent link="{{ arm.mount_link }}"/>
    <child link="{{ arm.axis.carriage_link }}"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="{{ arm.axis.direction }}"/>
    <limit lower="0" upper="{{ arm.axis.stroke_m }}" velocity="{{ arm.axis.max_speed_mps }}" effort="{{ arm.axis.max_force_n }}"/>
  </joint>
  <!-- One hardware component for the track, beside the arm's own: the same
       controller manager loads both, and only the plugin names which machine is
       behind it. The track's hardware path is not implemented (ADR-0067). -->
  <ros2_control name="{{ arm.axis.joint }}_system" type="system">
    <hardware>
      <plugin>{{ arm.axis.plugin }}</plugin>
    </hardware>
    <joint name="{{ arm.axis.joint }}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
{% endif %}

  <xacro:include filename="$(find {{ arm.package }})/{{ arm.file }}"/>
  <xacro:{{ arm.macro }}
{% for name, value in arm.args %}
      {{ name }}={{ value | attr }}
{% endfor %}
  />

  <!-- Bolt the arm to the world.

       `create_attach_link` is false and `{{ arm.mount_link }}` is not the name
       the URDF-to-SDF converter anchors on, so without this the arm's root is a
       free rigid body standing on its pedestal by contact friction alone. Joint
       reaction torques slide or tip it, and the symptom — base drift — reads as
       a calibration fault.

       The joint lives inside a `gazebo` block rather than as a URDF joint to a
       link named `world`, and that placement is the whole point: a URDF `world`
       link would make `robot_state_publisher` publish `world` -> mount as a
       second parent for a frame the generated static transform table already
       parents to `cite_world`. One frame, two parents, intermittently wrong.
       Inside `gazebo` the converter sees it and TF never does.

       The joint carries no pose. Where the arm stands is stated once, by the
       spawn pose in the bring-up plan; a pose here would apply it twice. -->
  <gazebo>
    <joint name="{{ arm.mount_link }}_world_anchor" type="fixed">
      <parent>world</parent>
      <child>{{ arm.mount_link }}</child>
    </joint>
  </gazebo>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find cite_generated)/control/{{ zone }}_{{ arm.id }}_controllers.yaml</parameters>
      <ros>
        <namespace>{{ arm.namespace }}</namespace>
      </ros>
    </plugin>
  </gazebo>
</robot>
