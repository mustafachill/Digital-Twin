---
{{ hash_banner() }}
#
# Which planners move_group loads for this arm, and which one plans by default
# (ADR-0027). Every pipeline this generator knows how to configure is declared;
# the model decides which one is asked first and which one a refusal falls back
# to.
#
# The list below, every block under it, and the comment above each block are
# rendered from one mapping — `PIPELINES` in `cite_tools/generate/moveit.py` —
# which is also what the model's choice is checked against. The template that
# produced this file names no pipeline at all, and that is the point: while the
# name set lived in two places, a third name passed the generator's guard and
# produced a file whose list omitted it, which is the exact failure the guard was
# written to prevent.
#
# Sampling-based planning is stochastic (ADR-0006) and is still reachable through
# the fallback. A scenario therefore asserts on outcomes and constraints, never on
# an exact joint sequence — a test that pins a trajectory will be flaky and will
# be deleted by whoever is on call. That holds under a deterministic planner too:
# it makes the same request produce the same answer, it does not make the request
# the same.
#
# The nesting matters. MoveIt looks for a planner under its pipeline's name; with
# these keys at the top level it falls back to looking in the node's own namespace
# and dies with "Planning plugin name is empty or not defined in namespace
# 'move_group'", which names the node rather than the missing pipeline.
planning_pipelines:
{% for name in pipelines %}
  - {{ name }}
{% endfor %}
default_planning_pipeline: {{ arm.default_pipeline }}
{% for name, pipeline in pipelines.items() %}

{{ name }}:
{% for note in pipeline.notes %}
{% if note %}
  # {{ note }}
{% else %}
  #
{% endif %}
{% endfor %}
  planning_plugins:
{% for plugin in pipeline.planning_plugins %}
    - {{ plugin }}
{% endfor %}
{% if pipeline.request_adapters %}
  request_adapters:
{% for adapter in pipeline.request_adapters %}
    - {{ adapter }}
{% endfor %}
{% endif %}
  response_adapters:
{% for adapter in pipeline.response_adapters %}
    - {{ adapter }}
{% endfor %}
{% if pipeline.planner_configs %}

  planner_configs:
{% for config in pipeline.planner_configs %}
    {{ config.name }}:
      type: {{ config.type }}
      range: {{ config.range | f }}
{% endfor %}

  {{ arm.group }}:
    planner_configs:
{% for config in pipeline.planner_configs %}
      - {{ config.name }}
{% endfor %}
    projection_evaluator: joints({{ arm.joints[0] }},{{ arm.joints[1] }})
{% if pipeline.longest_valid_segment_fraction is not none %}
    longest_valid_segment_fraction: {{ pipeline.longest_valid_segment_fraction | f }}
{% endif %}
{% endif %}
{% endfor %}
