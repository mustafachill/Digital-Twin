<?xml version="1.0"?>
{{ xml_banner() }}
<sdf version="1.9">
  <world name="{{ cell.zone }}">
    <physics name="default" type="ignored">
      <max_step_size>{{ step_size | m }}</max_step_size>
      <real_time_factor>{{ real_time_factor | m }}</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Contact reporting. Kept deliberately, though nothing in this repository
         reads it today: it was loaded for ADR-0023's attachment plugin, which is
         removed, and it is what any `<sensor type="contact">` a scenario declares
         would need. It is a generic simulator capability rather than plugin
         apparatus, so it is left in place rather than removed and rediscovered. -->
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

{% for conveyor in conveyors %}
    <!-- {{ conveyor.asset }} — a belt, as a simulation fidelity aid.

         A world system rather than a model plugin, because converting the scene
         from URDF to SDF lumps every fixed-jointed body into one link: there is
         no {{ conveyor.asset }} model in the spawned world to attach to. Every
         value below is resolved from L0, including the pose, which comes from
         the same surface frame the stations pick and place against.

         Nothing above ros2_control knows this exists. It speaks Gazebo transport
         only; naming and typing it for ROS is a bridge's business, above this
         boundary and identical on the hardware path. -->
    <plugin filename="cite_conveyor" name="cite_simulation::Conveyor">
      <surface_pose>{{ conveyor.surface_pose | map('m') | join(' ') }}</surface_pose>
      <belt_length_m>{{ conveyor.length_m | m }}</belt_length_m>
      <belt_width_m>{{ conveyor.width_m | m }}</belt_width_m>
      <carry_height_m>{{ conveyor.carry_height_m | m }}</carry_height_m>
      <direction>{{ conveyor.direction }}</direction>
      <installed_speed_mps>{{ conveyor.installed_speed_mps | m }}</installed_speed_mps>
      <command_topic>{{ conveyor.command_topic }}</command_topic>
      <state_topic>{{ conveyor.state_topic }}</state_topic>
      <publish_period_s>{{ publish_period_s | m }}</publish_period_s>
{% for model in workpieces %}
      <carry>{{ model }}</carry>
{% endfor %}
    </plugin>

{% endfor %}
{% for beam in beams %}
    <!-- {{ beam.asset }} — a through-beam presence sensor.

         A world system for the same reason the belts are: its housing is lumped
         into the scene's single link, so there is no {{ beam.asset }} model to
         attach to and its pose has to arrive as data. It is resolved from the
         same L0 placement that positions the housing, so the beam and the thing
         it is drawn as cannot end up in different places.

         beam_pose is where the HOUSING stands. beam_offset_m is how far past it,
         along the beam axis, the middle of the beam lies — because a through
         beam is emitted from its housing and crosses what it watches, rather
         than being centred on it. -->
    <plugin filename="cite_break_beam" name="cite_simulation::BreakBeam">
      <beam_pose>{{ beam.beam_pose | map('m') | join(' ') }}</beam_pose>
      <beam_axis>{{ beam.beam_axis }}</beam_axis>
      <beam_length_m>{{ beam.beam_length_m | m }}</beam_length_m>
      <beam_width_m>{{ beam.beam_width_m | m }}</beam_width_m>
      <beam_offset_m>{{ beam.beam_offset_m | m }}</beam_offset_m>
      <state_topic>{{ beam.detection_topic }}</state_topic>
      <publish_period_s>{{ publish_period_s | m }}</publish_period_s>
{% for model in workpieces %}
      <watch>{{ model }}</watch>
{% endfor %}
    </plugin>

{% endfor %}
{% for hold in grasp_holds %}
    <!-- {{ hold.asset }} — rigid grasp hold (ADR-0061).

         A world system for the reason the module docstring gives, not the one
         the belt and the beam have: it reaches across two independently
         spawned models, the arm and the work-piece, exactly as they do.

         MECHANISM. While {{ hold.drive_joint }}'s own velocity has not exceeded
         stall_velocity_threshold for stall_timeout_s of SIMULATED time — the
         identical rule GripperActionController already applies, read from the
         same controller configuration rather than restated (P1) — and the
         joint's own position lies inside [hold_position_min_rad,
         hold_position_max_rad], a declared graspable model within
         attach_radius_m of {{ hold.attach_link }}'s own origin is fixed to it.
         It is released the instant the joint moves back past the position it
         was holding at by more than detach_margin_rad, in the direction that
         opens the jaws.

         THE WINDOW, NOT THE RAILS (ADR-0061's 2026-09-22 correction). A rail
         exclusion — refusing a joint resting at open_position or
         closed_position — assumed a stall on a real part always lands
         strictly between the two and that jaws closing on nothing always
         settle at one of them. Neither holds: the ordinary close target is
         mid-stroke, and a tester measured jaws closing on empty air settling
         mid-stroke too. hold_position_min_rad/hold_position_max_rad are the
         drive-joint positions the facility's declared part interval — widened
         by the stall band at each edge — maps to through the end effector's
         own linkage, resolved at generation time rather than in this plugin
         (`cite_simulation` does not link against `cite_skills`). It is the
         identical window `cite_skills::gripper_is_holding` judges a stall
         inside (ADR-0052 option F), so the two can never disagree about what
         counts as a grasp.

         It touches no controller and no command interface. The jaws still
         close, still meet the part, still stop at its width and still report a
         stall — that signal is what `cite_skills::gripper_is_holding` reads and
         this plugin never sees it. The one thing this changes is that the box,
         having stopped the jaws, can no longer be twisted or dragged by them
         afterwards (ADR-0061).

         Nothing above ros2_control knows this exists. It speaks Gazebo
         transport only — it does not even speak that much, since it neither
         publishes nor subscribes — and it is absent from the hardware path,
         where a real gripper needs no help holding what it has clamped. -->
    <plugin filename="cite_grasp_hold" name="cite_simulation::GraspHold">
      <attach_link>{{ hold.attach_link }}</attach_link>
      <drive_joint>{{ hold.drive_joint }}</drive_joint>
      <stall_velocity_threshold>{{ hold.stall_velocity_threshold | m }}</stall_velocity_threshold>
      <stall_timeout_s>{{ hold.stall_timeout_s | m }}</stall_timeout_s>
      <detach_margin_rad>{{ hold.detach_margin_rad | m }}</detach_margin_rad>
      <open_position>{{ hold.open_position | m }}</open_position>
      <closed_position>{{ hold.closed_position | m }}</closed_position>
      <attach_radius_m>{{ hold.attach_radius_m | m }}</attach_radius_m>
      <hold_position_min_rad>{{ hold.hold_position_min_rad | m }}</hold_position_min_rad>
      <hold_position_max_rad>{{ hold.hold_position_max_rad | m }}</hold_position_max_rad>
{% for model in workpieces %}
      <graspable>{{ model }}</graspable>
{% endfor %}
    </plugin>

{% endfor %}
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>{{ ground_size | m }} {{ ground_size | m }}</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>{{ ground_size | m }} {{ ground_size | m }}</size></plane></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
